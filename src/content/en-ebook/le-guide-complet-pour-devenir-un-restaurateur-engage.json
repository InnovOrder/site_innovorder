  "rt-thank-you-html": "\n                    <h2>Your white paper is available 👇</h2>\n                    <p><strong>Thank you!</strong></p>\n                    <p><a href=\"https://5696087.fs1.hubspotusercontent-na1.net/hubfs/5696087/Livres%20blancs/Comment%20devenir%20un%20restaurateur%20engag%C3%A9.pdf\">Download</a></p>\n                    <p>Thank you <a target=\"_blank\" href=\"/en\">Innovorder</a> team</p>\n                  ",
  "rt-ebook-html": "\n              <p>EXKi, Bagel Corner and Ankka have made their restaurants part of a sustainable approach. Discover their initiatives to get inspired! </p>\n            ",
