  "icon-ebook-sizes-2": null,
  "icon-ebook-srcset-2": null,
  "rt-decouvrirez-block-html-2": "\n            <p><strong>How can you bring your commitment to life?</strong></p>\n            <p>Learn how to get the word out about your initiatives.</p>\n          ",
  "icon-ebook-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/64da91e0b2c7e3b7d8f28917_IO%20Analytics%201.avif",
