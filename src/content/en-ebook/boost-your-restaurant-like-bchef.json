  "title-00": "Boost your franchise like BCHEF!",
  "subtitle-hero-ebook-inner": "Discover how the BCHEF franchise has increased its sales and how its restaurants are making between 600K and 1M€ of turnover thanks to digital!",
  "name-value": "Boostez votre franchise comme BCHEF !",
  "image-form-ebook-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/641209b230cbae4dd0df2e1e_ebook2.avif",
  "image-form-ebook-sizes": "(max-width: 479px) 100vw, 269px",
