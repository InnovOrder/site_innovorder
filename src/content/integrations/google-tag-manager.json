  "image-kiosk-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dda583ce041a2bb1e50c9_Group%20763-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dda583ce041a2bb1e50c9_Group%20763.avif 1060w",
  "40px-txt": "Synchronisez Google Tag Manager à Innovorder.",
  "cta-sub-kiosk": "Intégrez Google Tag Manager à Innovorder pour mettre en place le suivi des données de votre restaurant, piloter facilement votre stratégie marketing et booster vos ventes."
