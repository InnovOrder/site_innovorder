  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Billiv </strong>est une solution de dématérialisation de tickets de caisse éco-responsable qui transforme vos tickets de caisse en outil marketing<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Faites la différence grâce à l’intégration <strong>Billiv </strong>:</h2>\n            ",
  "rt-features-integration-html": "\n              <li>Augmentez la fidélisation de votre clientèle de 30% par rapport aux programmes de fidélité classiques basés sur des cartes ou des inscriptions (email ou n° de téléphone)</li>\n              <li>Multipliez par 5 le nombre d’avis clients sur des plateformes comme Google ou TripAdvisor</li>\n              <li>Proposez facilement vos offres du moment</li>\n              <li>Permettez à vos clients de collecter des points de fidélité </li>\n              <li>Multipliez par 4 la portée de vos communications par rapport au ticket par email</li>\n            ",
  "button-icon-hp-href": "https://www.billiv.fr/",
