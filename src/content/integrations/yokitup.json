  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Yokitup </strong>est un logiciel de gestion des stocks. Grâce à sa richesse fonctionnelle, optimisez vos coûts matières, réduisez vos pertes et analysez efficacement vos ratios pour améliorer votre rentabilité<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Faites la différence grâce à l’intégration <strong>Yokitup </strong>:</h2>\n            ",
  "rt-features-integration-html": "\n              <li>Visualisez l'intégralité de vos données avec un outil unique</li>\n              <li>Suivez en temps réel l'activité de chacun de vos restaurants</li>\n              <li>Automatisez vos approvisionnements grâce à un algorithme de prévision des commandes</li>\n              <li>Gagnez jusqu’à 20 heures par mois sur la gestion de l'approvisionnement grâce aux recommandations fournies par Yokitup</li>\n            ",
  "button-icon-hp-href": "https://www.yokitup.com/",
