  "wg-selector-2-href": "/en/commercial-catering/dark-kitchen",
  "wg-selector-2-href-2": "/restauration-commerciale/dark-kitchen",
  "expertises-hero-text-html": "Développez votre <strong>dark kitchen</strong> avec Innovorder",
  "text-17px-html": "\n            <p>Mettez de l’ordre dans vos cuisines et développez les marques virtuelles de votre dark kitchen ! </p>\n            <p>Multipliez vos canaux de livraison en quelques clics et augmentez vos ventes avec l’écosystème connecté Innovorder.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59ee231a01d9_dark%20kitchen%20hero11.avif",
  "expertise-img-alt": "",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5900491a01cc_dark%20kitchen11.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5900491a01cc_dark%2520kitchen11-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5900491a01cc_dark%20kitchen11.avif 1000w",
  "title50px": "Gagnez du temps grâce au digital",
  "subtitle-hover-block-html": "\n            <p>Boostez votre efficacité opérationnelle et gagnez du temps à chaque étape en agrégeant toutes les commandes de tous vos canaux de vente (commande en ligne en marque blanche, bornes de commandes tournées vers l’extérieur, etc.).</p>\n          ",
  "title50px-2": "Augmentez votre productivité en cuisine",
  "subtitle-hover-block-html-2": "\n            <p>Digitalisez vos espaces de préparation, organisez efficacement le dispatch et servez toujours plus de clients en augmentant la cadence en toute sérénité. Limitez les erreurs grâce à un écosystème de solutions pensées pour les volumes de commande élevés.</p>\n          ",
  "expertise-img-alt-2": "",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc599ecf1a01da_dark%20kitchen22.avif",
  "expertise-img-sizes": "100vw",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc599ecf1a01da_dark%2520kitchen22-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc599ecf1a01da_dark%20kitchen22.avif 996w",
  "expertise-img-alt-3": "",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5915d11a01d2_dark%20kitchen33.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5915d11a01d2_dark%2520kitchen33-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5915d11a01d2_dark%20kitchen33.avif 1006w",
  "title50px-3": "Pilotez votre activité avec la data",
  "subtitle-hover-block-html-3": "\n            <p>Suivez en temps réel les performances de votre dark kitchen et de vos marques, quels que soient vos canaux de vente. </p>\n            <p>Pilotez votre carte et vos menus simplement, avec ou sans agrégateur de plateformes (Deliverect, etc.) et gardez toujours un œil sur vos stocks, vos ressources et votre comptabilité grâce à nos intégrations partenaires.</p>\n          ",
  "section-20-class": "section-20 expertise-top logos",
  "div-script": "<script type=\"text/x-wf-template\" id=\"wf-template-51be7c34-8120-35d9-1339-47bdd81e1fe3\">%3Cdiv%20role%3D%22listitem%22%20class%3D%22w-dyn-item%20w-dyn-repeater-item%22%3E%3Cimg%20alt%3D%22%22%20loading%3D%22lazy%22%20width%3D%22134%22%20src%3D%22https%3A%2F%2Fcdn.prod.website-files.com%2F63f501f2fcfc599ea419f99b%2F652fbeef8f977a8fe3b0ecb1_suprem.avif%22%20class%3D%22image-client%22%2F%3E%3C%2Fdiv%3E</script>",
