 "fields": {
  "wg-selector-2-href": "/en/commercial-catering/fast-food",
  "wg-selector-2-href-2": "/restauration-commerciale/fast-food",
  "expertises-hero-text-html": "L’écosystème le plus adapté à la <strong>restauration rapide</strong>",
  "text-17px-html": "\n            <p>Simplifiez-vous la vie avec des solutions digitales pensées pour gérer de gros volumes en toute sérénité, de la prise de commande à l’encaissement en passant par la préparation et la livraison.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc591beb1a01c7_hero%20independant1.avif",
  "expertise-img-alt": "",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59f59c1a01c8_independant11.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59f59c1a01c8_independant11-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59f59c1a01c8_independant11.avif 1009w",
  "title50px": "Multipliez vos commandes",
  "subtitle-hover-block-html": "\n            <p>Proposez à vos clients les solutions les plus modernes pour commander dans votre restaurant : bornes de commande, commande en ligne en click and collect ou en livraison.</p>\n            <p>Faites confiance au meilleur de la technologie pour générer plus de revenus en augmentant votre panier moyen grâce aux ventes additionnelles.</p>\n          ",
  "title50px-2": "Gagnez du temps sur l’encaissement",
  "subtitle-hover-block-html-2": "\n            <p>Avec le paiement aux bornes ou en ligne, rendez vos clients autonomes et dégagez-vous du temps pour vous concentrer sur votre métier : la restauration ! </p>\n            <p>Connectée à toutes les solutions Innovorder, la caisse devient la cheffe d’orchestre idéale de votre activité.</p>\n          ",
  "expertise-img-alt-2": "",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc593b121a01c6_independant22.avif",
  "expertise-img-sizes": "100vw",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc593b121a01c6_independant22-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc593b121a01c6_independant22.avif 1009w",
  "expertise-img-alt-3": "",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5970d01a01cf_independant33.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5970d01a01cf_independant33-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5970d01a01cf_independant33.avif 1009w",
  "title50px-3": "Optimisez la préparation en cuisine",
  "subtitle-hover-block-html-3": "\n            <p>Fast food, pizzeria, poké, kebab, tacos, etc. Relevez tous les défis de la restauration rapide !</p>\n            <p>Répondez à toutes vos commandes en un temps record en équipant vos postes de travail avec des écrans de production.</p>\n          ",
