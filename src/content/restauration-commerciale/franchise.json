  "head:link-href": "https://www.innovorder.com/restauration-commerciale/franchise",
  "link-href-2": "https://www.innovorder.com/en/commercial-catering/franchise",
  "expertises-hero-text-html": "Développez votre franchise grâce à un <strong>écosystème scalable et évolutif</strong>",
  "text-17px-html": "\n            <p>Développez votre concept de restauration, multipliez vos points de vente rapidement et pilotez votre activité multisites en toute simplicité avec les solutions digitales Innovorder.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59130c1a01cb_hero%20franchise1.avif",
  "expertise-img-alt": "",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%2011.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%252011-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%2011.avif 1002w",
  "title50px": "Augmentez la rentabilité de vos points de vente",
  "subtitle-hover-block-html": "\n            <p>Borne de commandes, commande en ligne, écran de production et caisse tactile : digitalisez les restaurants de votre chaîne et propulsez votre franchise dans la restauration du futur.</p>\n            <p>Augmentez votre panier moyen, organisez vos équipes et suivez vos stocks en toute simplicité.</p>\n          ",
  "title50px-2": "Gérez tous vos établissements avec une seule interface",
  "subtitle-hover-block-html-2": "\n            <p>Gérer un réseau de restaurants demande du temps. Pilotez tous vos points de vente à distance avec le backoffice Innovorder.</p>\n            <p>Gérez vos menus, mettez à jour vos prix et surveillez la performance de chaque établissement en quelques clics.</p>\n          ",
  "expertise-img-alt-2": "",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59576e1a01d3_franchise%2022.avif",
  "expertise-img-sizes": "100vw",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59576e1a01d3_franchise%252022-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59576e1a01d3_franchise%2022.avif 999w",
  "expertise-img-alt-3": "",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc597c291a01cd_franchise%2033.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc597c291a01cd_franchise%252033-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc597c291a01cd_franchise%2033.avif 1002w",
  "title50px-3": "Composez avec le meilleur de la technologie",
  "subtitle-hover-block-html-3": "\n            <p>Profitez d’un écosystème digital sur-mesure, synchronisable avec les meilleures solutions du marché.</p>\n            <p>Innovorder s’intègre avec vos logiciels préférés de gestion de planning, de livraison à domicile, ou encore de fidélité.</p>\n          ",
