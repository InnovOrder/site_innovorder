  "wg-selector-2-href-2": "/restauration-commerciale/food-court",
  "expertises-hero-text-html": "Le leader français sur le marché des <strong>food courts</strong>",
  "text-17px-html": "\n            <p>Equipez votre food court avec l’écosystème de solutions digitales le plus complet et le plus innovant du marché.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc598a8d1a01ce_food%20court%20hero1.avif",
  "expertise-img-alt": "",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59e9921a01de_food%20court%2011.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59e9921a01de_food%2520court%252011-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59e9921a01de_food%20court%2011.avif 1254w",
  "title50px": "Créez votre food court en toute simplicité",
  "subtitle-hover-block-html": "\n            <p>Gérez votre food court efficacement avec un interlocuteur unique. </p>\n            <p>Innovorder est le seul prestataire Français à pouvoir déployer 100% des solutions indispensables à la gestion de votre food court : prise de commande, encaissement, préparation, livraison et pilotage.</p>\n          ",
  "title50px-2": "Profitez du meilleur de la foodtech",
  "subtitle-hover-block-html-2": "\n            <p>Demandez les solutions digitales les plus avancées pour gérer votre food court : commande à table, commande sur smartphone, multi-corners, multi-baskets, suivi en temps réel et alertes de la préparation des commandes entre les corners, reportings consolidés pour l’exploitant et les concessionnaires, etc.</p>\n          ",
  "expertise-img-alt-2": "",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59ac741a01d5_food%20court%2022.avif",
  "expertise-img-sizes": null,
  "expertise-img-srcset-2": null,
  "expertise-img-alt-3": "",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908631a01d0_food%20court%2033.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908631a01d0_food%2520court%252033-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908631a01d0_food%20court%2033.avif 999w",
  "title50px-3": "Repoussez le champ des possibles",
  "subtitle-hover-block-html-3": "\n            <p>Bénéficiez des conseils de nos experts de la restauration rapide pour co-créer des parcours de commande innovants, optimiser votre espace et piloter le lancement de vos corners, quelle que soit la complexité de votre projet.</p>\n          ",
