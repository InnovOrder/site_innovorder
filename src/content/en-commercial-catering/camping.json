  "head:link-href": "https://www.innovorder.com/restauration-commerciale/camping",
  "link-href-2": "https://www.innovorder.com/en/commercial-catering/camping",
  "expertises-hero-text-html": "Improve your <strong>campsite</strong>'s catering service",
  "text-17px-html": "\n            <p>Offer your guests quick and easy access to food and beverages by streamlining your service and reducing waiting times at your point of sale.</p>\n          ",
  "image-hero-expertise-alt": "Campsite catering service",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491658b03c8659cac24d8_63f501f3fcfc591beb1a01c7_hero%2520independant1.avif.avif",
  "expertise-img-alt": "QR code to order at the campsite",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491777d8dbf98a2d52bf2_63f501f3fcfc59f59c1a01c8_independant11.avif.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491777d8dbf98a2d52bf2_63f501f3fcfc59f59c1a01c8_independant11.avif-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491777d8dbf98a2d52bf2_63f501f3fcfc59f59c1a01c8_independant11.avif.avif 805w",
  "title50px": "Organize order taking",
  "subtitle-hover-block-html": "\n            <p>Give your guests the freedom to order from the comfort of their pitch, without having to queue. Thanks to digital order-taking and an integrated loyalty program, the experience is seamless and personalized, even in high season.</p>\n          ",
  "title50px-2": "Manage the restoration of your campsite",
  "subtitle-hover-block-html-2": "\n            <p>Simplify snack cash-out with a cash register that centralizes all your orders. Make your menus accessible via QR codes, track your sales in real time and increase your average basket with intelligent additional sales.</p>\n          ",
  "expertise-img-alt-2": "Campsite sales follow-up",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68849184d1a9f2c75bd31e1f_63f501f3fcfc593b121a01c6_independant22.avif.avif",
  "expertise-img-sizes": "100vw",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68849184d1a9f2c75bd31e1f_63f501f3fcfc593b121a01c6_independant22.avif-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68849184d1a9f2c75bd31e1f_63f501f3fcfc593b121a01c6_independant22.avif-p-800.avif 800w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68849184d1a9f2c75bd31e1f_63f501f3fcfc593b121a01c6_independant22.avif.avif 808w",
  "expertise-img-alt-3": "Order picking at the campsite",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491935c3bbaacad5c7a42_63f501f3fcfc5970d01a01cf_independant33.avif.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491935c3bbaacad5c7a42_63f501f3fcfc5970d01a01cf_independant33.avif-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/688491935c3bbaacad5c7a42_63f501f3fcfc5970d01a01cf_independant33.avif.avif 808w",
  "title50px-3": "Key features for your campsite",
  "subtitle-hover-block-html-3": "\n            <p>Offer your campers a seamless experience, from payment to order collection. Easily pay on site, at the bar or snack bar, whatever the method of payment. Thanks to real-time tracking, your campers receive a notification as soon as their order is ready, telling them where to pick it up (counter, directly on the table...).</p>\n          ",
  "section-20-class": "section-20 expertise-top logos w-condition-invisible",
  "div-script": "<script type=\"text/x-wf-template\" id=\"wf-template-51be7c34-8120-35d9-1339-47bdd81e1fe3\">%3Cdiv%20role%3D%22listitem%22%20class%3D%22w-dyn-item%20w-dyn-repeater-item%22%3E%3Cimg%20alt%3D%22%22%20loading%3D%22lazy%22%20width%3D%22134%22%20src%3D%22%22%20class%3D%22image-client%20w-dyn-bind-empty%22%2F%3E%3C%2Fdiv%3E</script>",
