  "expertises-hero-text-html": "The French leader in the <strong>food courts</strong>&nbsp;market",
  "text-17px-html": "\n            <p>Equip your food court with the most complete and innovative ecosystem of digital solutions on the market.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc598a8d1a01ce_food%20court%20hero1.avif",
