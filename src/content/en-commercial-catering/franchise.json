  "wg-selector-2-href": "/en/commercial-catering/franchise",
  "wg-selector-2-href-2": "/restauration-commerciale/franchise",
  "expertises-hero-text-html": "Expand your franchise with a <strong>scalable, evolving ecosystem</strong>",
  "text-17px-html": "\n            <p>Develop your catering concept, multiply your points of sale rapidly and manage your multi-site business with ease, thanks to Innovorder's digital solutions.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59130c1a01cb_hero%20franchise1.avif",
  "expertise-img-alt": "",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%2011.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%252011-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59d93b1a01c3_franchise%2011.avif 1002w",
  "title50px": "Increase the profitability of your points of sale",
  "subtitle-hover-block-html": "\n            <p>Kiosk, online ordering, production screen and touch screen cash register: digitalize your chain's restaurants and propel your franchise into the restaurant industry of the future.</p>\n            <p>Increase your average basket, organize your teams and track your inventory with ease.</p>\n          ",
  "title50px-2": "Manage all your facilities with a single interface",
  "subtitle-hover-block-html-2": "\n            <p>Managing a network of restaurants takes time. Manage all your points of sale remotely with the Innovorder backoffice.</p>\n            <p>Manage your menus, update your prices and monitor the performance of each establishment in a few clicks.</p>\n          ",
  "expertise-img-alt-2": "",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59576e1a01d3_franchise%2022.avif",
  "expertise-img-sizes": "100vw",
