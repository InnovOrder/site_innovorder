  "expertises-hero-text-html": "The ecosystem best suited to <strong>fast food</strong>",
  "text-17px-html": "\n            <p>Simplify your life with digital solutions designed to manage large volumes with complete peace of mind, from order taking to collection, preparation and delivery.</p>\n          ",
  "image-hero-expertise-alt": "",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc591beb1a01c7_hero%20independant1.avif",
