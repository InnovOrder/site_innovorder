  "head:field-script": "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.innovorder.com/en/blog/the-funniest-restaurant-reviews\"},\"headline\":\"The 40 funniest restaurant reviews\",\"description\":\"We've listed the funniest restaurant reviews left by customers. Some of them are to die for!\",\"image\":\"https://cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/64be97f3a68ac0030fa4d182_6436d32f4941244afdc9c015_iStock-510591722.avif\",\"author\":{\"@type\":\"Person\",\"name\":\"Louis de Champs\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Innovorder\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc5931ce19fd4b_Logo%20Innovorder.svg\"},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"4.9\",\"reviewCount\":\"550\",\"bestRating\":\"5\",\"worstRating\":\"1\"}},\"datePublished\":\"10 avril 2023\",\"dateModified\":\"3 juillet 2025\",\"articleSection\":\"Trends and news\",\"timeRequired\":\"4\"}</script>",
