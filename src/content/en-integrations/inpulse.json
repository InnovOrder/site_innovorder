  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Inpulse </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Gain up to 5 margin points on your material costs</li>\n              <li>Anticipate with reliable forecasts</li>\n              <li>Order what you really need</li>\n              <li>Automate your production plan</li>\n              <li>Retrieve all your food chain data</li>\n            ",
