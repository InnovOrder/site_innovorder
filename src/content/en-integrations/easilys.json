  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Easilys </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Create your offers in just a few clicks</li>\n              <li>Automate your strategy based on your performance</li>\n              <li>Analyze the effectiveness of your campaigns and increase your profitability</li>\n              <li>Measure your visibility and that of your competitors</li>\n            ",
