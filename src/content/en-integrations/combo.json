  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Combo </strong>is an HR tool designed for operational staff and their teams in the field. It simplifies HR management, from scheduling to payroll, thanks to an intuitive platform<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Combo </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Automate your DPAE and contracts</li>\n              <li>Save 80% of your HR management time</li>\n              <li>Save between €800 and €1,000 on administrative costs</li>\n              <li>Receive notifications so you're always compliant</li>\n            ",
  "button-icon-hp-href": "https://combohr.com/fr/",
