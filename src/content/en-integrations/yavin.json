  "title-00": "Innovorder & Yavin",
  "text-17px": "By integrating Yavin into your Innovorder cash register, you can collect all your orders more quickly and concentrate on your customers.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/669395bb083f1fe4f7c61be4_hero.avif",
  "logo-integration-inner-hero-alt": "Yavin",
  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Yavin </strong>reinvents electronic payment terminals to offer ultra-fast, reliable and innovative POS terminals to foodservice professionals<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make a difference with <strong>Yavin </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Save time by automatically transferring the amount from your till to your POS terminal</li>\n              <li>Automate remote collections from your devices and close your till in 1 click</li>\n              <li>Integrate your payment terminal directly into your order terminals to streamline checkout and order preparation</li>\n              <li>Accept all payment methods on your devices</li>\n              <li>Cash in even without Internet and never lose a sale again</li>\n            ",
  "button-icon-hp-href": "https://yavin.com/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover Yavin",
  "image-kiosk-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/66939601b0a8e6087748bd70_feature-img.avif",
  "image-kiosk-sizes": null,
  "image-kiosk-srcset": null,
  "40px-txt": "Synchronize Yavin with Innovorder.",
  "cta-sub-kiosk": "By integrating Yavin with Innovorder, create the perfect connection between your cash register software and your payment terminals. Cash in faster, simplify payment and improve transaction management."
