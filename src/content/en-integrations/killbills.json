  "text-17px": "Synchronize KillBills with your Innovorder cash register software and free yourself from paper tickets for good.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/66793b01acc128ff6fdd46cd_Rectangle%20813.avif",
