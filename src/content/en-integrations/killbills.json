  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>KillBills </strong>revolutionizes the sales receipt by instantly dematerializing it in the customer's banking space. Its ambition: to eradicate paper sales receipts.",
  "h2-logos-prix-html": "\n              <p>Make a difference with <strong>KillBills </strong> integration <strong data-wg-splitted>: </strong></p>\n            ",
  "rt-features-integration-html": "\n              <li>Save time and money by no longer systematically printing your tickets.</li>\n              <li>Send your dematerialized tickets automatically with each payment</li>\n              <li>Your customers don't have to do a thing: no app downloads, no emails, no QR codes to flash.</li>\n            ",
  "button-icon-hp-href": "https://www.killbills.co/commerce",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover KillBills",
