  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Como </strong>is a suite of marketing solutions dedicated to customer relationship management: loyalty programs, omnichannel communication, automated marketing, etc<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Como </strong> integration <strong>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Standardize your customer path, regardless of the ordering channel (checkout, kiosk, online ordering, click &amp; serve), and multiply your chances of building customer loyalty.</li>\n              <li>Personalize and simplify the customer experience in your restaurant</li>\n              <li>Offer discounts by basket or by product (earn principle, for accumulating points, and burn principle, for converting points into rewards).</li>\n              <li>Gain valuable insights into your customers' buying behavior</li>\n            ",
  "button-icon-hp-href": "https://fr.como.com/",
