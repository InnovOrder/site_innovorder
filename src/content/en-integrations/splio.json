  "text-17px": "Reward and retain your best customers with every visit, and let them enjoy a host of benefits thanks to Splio integration.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dd15e07099e7edc89acd5_Group%20801.avif",
