  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Splio </strong>is a CRM platform for marketing automation and customer relations that helps restaurateurs turn their customer data into sales opportunities<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Splio </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Standardize your customer journey across your preferred ordering channels (checkout, kiosk, online ordering, click &amp; serve) and increase your chances of building customer loyalty.</li>\n              <li>Personalize and simplify the customer experience in your restaurant</li>\n              <li>Offer discounts by basket or by product (earn principle, for accumulating points, and burn principle, for converting points into rewards).</li>\n              <li>Gather valuable information on your customers' buying behavior</li>\n            ",
  "button-icon-hp-href": "https://splio.com/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover Splio",
