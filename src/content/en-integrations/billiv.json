  "text-17px": "Build customer loyalty automatically and boost your Google reviews with every order, thanks to Billiv integration.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/66938f4b400954f7dddc8cb3_hero.avif",
  "logo-integration-inner-hero-alt": "Billiv",
  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Billiv </strong>is an eco-responsible dematerialized sales receipt solution that transforms your sales receipts into a marketing tool<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make the difference with <strong>Billiv </strong> integration <strong data-wg-splitted>: </strong></h2>\n            ",
  "rt-features-integration-html": "\n              <li>Increase customer loyalty by 30% compared with traditional loyalty programs based on cards or registrations (email or phone number).</li>\n              <li>Multiply by 5 the number of customer reviews on platforms like Google or TripAdvisor</li>\n              <li>Easily propose your current offers</li>\n              <li>Allow your customers to collect loyalty points </li>\n              <li>Increase the reach of your communications by a factor of 4 compared with email tickets</li>\n            ",
  "button-icon-hp-href": "https://www.billiv.fr/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover Billiv",
  "image-kiosk-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/66938f8d383af357003e63c4_feature-img.avif",
