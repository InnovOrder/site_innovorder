  "text-17px": "Generate more revenue by capturing, activating and retaining your customers with Hey Pongo integration.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dd2d86edec3fc5b6d2e7b_Hey%20Pongo.avif",
