  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Hey Pongo</strong> is a marketing platform that enables you to collect, centralize and exploit your customer data for innovative loyalty programs<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make a difference with <strong>Hey Pongo</strong> integration:</h2>\n            ",
  "rt-features-integration-html": "\n              <li>Standardize your customer journey across your preferred ordering channels (checkout, kiosk, online ordering, click &amp; serve) and increase your chances of building customer loyalty.</li>\n              <li>Personalize and simplify the customer experience in your restaurant</li>\n              <li>Offer discounts by basket or by product</li>\n              <li>Offer discounts by basket or by product (earn principle, for accumulating points, and burn principle, for converting points into rewards).</li>\n              <li>Gather valuable information on your customers' buying behavior</li>\n            ",
  "button-icon-hp-href": "https://www.heypongo.com/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover Hey Pongo",
