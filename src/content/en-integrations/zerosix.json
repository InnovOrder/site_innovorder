  "text-17px": "Generate more revenue by capturing, activating and retaining your customers with ZEROSIX integration.",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4cf559d9183c3f824f07_Group%20807.avif",
  "logo-integration-inner-hero-alt": "ZEROSIX",
