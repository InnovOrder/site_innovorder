  "logo-integration-inner-hero-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4cf559d9183c3f824f07_Group%20807-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4cf559d9183c3f824f07_Group%20807.avif 518w",
  "24-rt-gradient-html": "<strong>ZEROSIX </strong>is a marketing platform that enables you to collect, centralize and leverage your customer data to create innovative, high-performance loyalty programs.",
  "h2-logos-prix-html": "\n              <h2>Make the difference with ZEROSIX integration:</h2>\n            ",
  "rt-features-integration-html": "\n              <li>Offer a seamless customer experience across all your ordering channels (checkout, kiosk, online, click &amp; serve) to maximize customer loyalty.</li>\n              <li>Simplify and personalize your customers' restaurant experience.</li>\n              <li>Set up attractive discounts, whether linked to the basket or to a specific product.</li>\n              <li>Benefit from a comprehensive loyalty system based on the earn &amp; burn principle: your customers collect points with every purchase and easily convert them into rewards.</li>\n              <li>Collect and analyze key purchase behavior data to optimize your marketing actions.</li>\n            ",
  "button-icon-hp-href": "https://www.zerosix.com/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover ZEROSIX",
  "image-kiosk-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4d3943ef94e925c2f9d7_Group%20763.avif",
  "image-kiosk-sizes": "(max-width: 479px) 100vw, 467px",
  "image-kiosk-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4d3943ef94e925c2f9d7_Group%20763-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/68fa4d3943ef94e925c2f9d7_Group%20763.avif 795w",
  "40px-txt": "Synchronize ZEROSIX with Innovorder.",
  "cta-sub-kiosk": "Boost your Google reviews, build customer loyalty and stand out from the crowd thanks to your customer data by integrating ZEROSIX into your Innovorder ecosystem."
