  "text-17px": "Ensure smooth service and centralize all your orders on your Innovorder POS with Uber Eats integration. ",
  "logo-integration-inner-hero-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dc9a36ec8eed06e657340_uber%20eats%20hero.avif",
  "logo-integration-inner-hero-alt": "Uber Eats",
  "logo-integration-inner-hero-sizes": null,
  "logo-integration-inner-hero-srcset": null,
  "24-rt-gradient-html": "<strong>Uber Eats</strong> is a global reference in home delivery. The platform connects restaurateurs with millions of customers<strong>.</strong>",
  "h2-logos-prix-html": "\n              <h2>Make a difference with <strong>Uber Eats</strong> integration:</h2>\n            ",
  "rt-features-integration-html": "\n              <li>Centralize all your Uber Eats orders on your Innovorder cash register</li>\n              <li>Analyze your delivery activity with dedicated dashboards</li>\n              <li>Follow all your deliveries live from the Uber Eats interface</li>\n              <li>Manage and synchronize your menus directly from the Uber Eats platform</li>\n              <li>Save time by simplifying your order flow</li>\n            ",
  "button-icon-hp-href": "https://www.uber.com/fr/fr/deliver/",
  "w-node-77b77414-b9e7-e0e5-4124-2b2a5107031a-0697d94c": "Discover Uber Eats",
  "image-kiosk-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/665dc9ee9b6e1e21f33e1d1a_Group%20763.avif",
