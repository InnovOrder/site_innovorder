  "expertises-hero-text-html": "Innovorder, la solution digitale pour la <strong>restauration scolaire</strong>",
  "text-17px-html": "\n            <p>Repensez le self et la cafétéria de votre établissement scolaire ou universitaire avec des solutions connectées qui plairont autant à vos élèves, à leurs parents et à vos équipes.</p>\n          ",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc597f511a01e7_enseignement%20hero%201.avif",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5976941a01ec_enseignement%201.avif",
