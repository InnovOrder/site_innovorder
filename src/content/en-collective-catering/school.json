  "expertises-hero-text-html": "Innovorder, the digital solution for <strong>school catering</strong>",
  "text-17px-html": "\n            <p>Rethink your school or university cafeteria with connected solutions that will appeal to your students, their parents and your staff.</p>\n          ",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc597f511a01e7_enseignement%20hero%201.avif",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5976941a01ec_enseignement%201.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5976941a01ec_enseignement%25201-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5976941a01ec_enseignement%201.avif 1000w",
  "title50px": "Automate the passage of your students to the canteen",
  "subtitle-hover-block-html": "\n            <p>Eliminate queuing (and pushing and shoving) at the food court with connected solutions modeled on fast food.</p>\n            <p>Give them more break time at lunch by reducing the line at the front of the cafeteria.</p>\n          ",
  "title50px-2": "Modernize your school restaurant from A to Z",
  "subtitle-hover-block-html-2": "\n            <p>Have your students come back with the codes of commercial catering. </p>\n            <p>Seduce ultra-connected students with online school menus, touch-sensitive ordering stations and a touch of artificial intelligence to scan their lunch tray!</p>\n          ",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59243e1a01e8_enseignement%202.avif",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59243e1a01e8_enseignement%25202-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59243e1a01e8_enseignement%202.avif 1000w",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5903971a01e6_enseignement%203.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5903971a01e6_enseignement%25203-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5903971a01e6_enseignement%203.avif 1000w",
  "title50px-3": "Reassure your students' parents",
  "subtitle-hover-block-html-3": "\n            <p>Focus on transparency! </p>\n            <p>With the E-wallet, give them access to their child's account and provide them with better tracking of their budget and daily diet.</p>\n          ",
