  "expertises-hero-text-html": "Innovorder, for <strong>communities</strong> and <strong>administrations</strong>",
  "text-17px-html": "\n            <p>Simplify the end of the month for your administrative or inter-administrative restaurant with our reliable, complete and intuitive solution!</p>\n          ",
  "image-hero-expertise-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc59b4911a01ea_administration%20hero1.avif",
  "expertise-img-src": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc595d9f1a01e9_administration1.avif",
  "expertise-img-srcset": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc595d9f1a01e9_administration1-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc595d9f1a01e9_administration1.avif 1000w",
  "title50px": "Save time at the end of each month",
  "subtitle-hover-block-html": "\n            <p>Thanks to our complete collection system, you can use reliable data, easily carry out your accounting and consolidate the financial statements of your structure.</p>\n          ",
  "title50px-2": "Benefit from an unparalleled wealth of functionality",
  "subtitle-hover-block-html-2": "\n            <p>Designed for collective catering, Innovorder takes into account all management rules (admissions, subsidies) and is constantly being enhanced with new features. Certified NF 525, Innovorder interfaces with many production management solutions.</p>\n          ",
  "expertise-img-src-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5931891a01df_administration2.avif",
  "expertise-img-srcset-2": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5931891a01df_administration2-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5931891a01df_administration2.avif 1000w",
  "expertise-img-src-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908291a01e2_administration3.avif",
  "expertise-img-srcset-3": "/assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908291a01e2_administration3-p-500.avif 500w, /assets/cdn.prod.website-files.com/63f501f2fcfc599ea419f99b/63f501f3fcfc5908291a01e2_administration3.avif 1000w",
  "title50px-3": "Don't think about your budget",
  "subtitle-hover-block-html-3": "\n            <p>Take advantage of an offer that adapts to all catering establishments, simple to install and use.</p>\n          ",
