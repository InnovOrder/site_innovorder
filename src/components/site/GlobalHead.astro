<meta name="facebook-domain-verification" content="trjjvvihjfj1gqabcbt41zf1uoenx6">
<!-- Conservation et propagation du tracking vers /nous-contacter -->
<script is:inline>
(function () {

  var TRACKING_PARAMS = [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_content",
    "utm_term",
    "oppref"
  ];


  /*
   * Enregistre dans sessionStorage
   * les paramètres présents sur la landing page.
   */
  function saveTrackingParams() {

    var params = new URLSearchParams(window.location.search);

    TRACKING_PARAMS.forEach(function (key) {

      var value = params.get(key);

      if (value) {
        sessionStorage.setItem(key, value);
      }

    });

  }


  /*
   * Ajoute les paramètres mémorisés
   * à une URL.
   */
  function addTrackingToUrl(url) {

    TRACKING_PARAMS.forEach(function (key) {

      var value = sessionStorage.getItem(key);

      if (value && !url.searchParams.has(key)) {
        url.searchParams.set(key, value);
      }

    });

    return url;

  }


  /*
   * Met à jour tous les liens vers
   * /nous-contacter.
   */
  function updateContactLinks() {

    var links = document.querySelectorAll("a[href]");

    links.forEach(function (link) {

      try {

        var url = new URL(link.href, window.location.href);

        var isInnovorder =
          url.hostname === "www.innovorder.com" ||
          url.hostname === "innovorder.com";

        var isContactPage =
          url.pathname.replace(/\/$/, "") === "/nous-contacter";

        if (isInnovorder && isContactPage) {

          url = addTrackingToUrl(url);

          link.href = url.toString();

        }

      } catch (e) {
        // Ignore les URLs non valides
      }

    });

  }


  /*
   * Initialisation.
   */
  function initTrackingPropagation() {

    /*
     * 1. Sauvegarde les paramètres
     * de la landing page.
     */
    saveTrackingParams();


    /*
     * 2. Met à jour les liens déjà présents.
     */
    updateContactLinks();


    /*
     * 3. Surveille les éléments ajoutés
     * dynamiquement par Webflow.
     */
    var observer = new MutationObserver(function () {

      updateContactLinks();

    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });


    /*
     * 4. Sécurité au moment exact du clic.
     * Le tracking est ajouté juste avant
     * la navigation vers /nous-contacter.
     */
    document.addEventListener(
      "click",
      function (event) {

        var link = event.target.closest("a[href]");

        if (!link) {
          return;
        }

        try {

          var url = new URL(link.href, window.location.href);

          var isInnovorder =
            url.hostname === "www.innovorder.com" ||
            url.hostname === "innovorder.com";

          var isContactPage =
            url.pathname.replace(/\/$/, "") === "/nous-contacter";

          if (isInnovorder && isContactPage) {

            url = addTrackingToUrl(url);

            link.href = url.toString();

          }

        } catch (e) {
          // Ignore les URLs non valides
        }

      },
      true
    );

  }


  /*
   * Attend que le DOM soit prêt.
   */
  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      initTrackingPropagation
    );

  } else {

    initTrackingPropagation();

  }

})();
</script>
