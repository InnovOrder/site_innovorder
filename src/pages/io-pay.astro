        },
        {
          "@type": "Product",
          "@id": "https://www.innovorder.com/io-pay#product",
          "name": "IO Pay - Solution Monétique Innovorder",
          "description": "Système de paiement intégré pour la restauration. Compatible TPE Android et SoftPos. Sécurité renforcée et gestion simplifiée des flux financiers.",
          "image": "https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/684c22491c48f273c6064718_Group%20767.avif",
          "brand": {
            "@type": "Brand",
            "name": "Innovorder"
          },
          "manufacturer": {
            "@type": "Organization",
            "@id": "https://www.innovorder.com/#organization",
            "name": "Innovorder",
            "url": "https://www.innovorder.com"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "442"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://www.innovorder.com/io-pay#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Comment installer IO Pay dans son restaurant ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un contrat monétique IO Pay doit préalablement être mis en place. L’installation et le paramétrage sont ensuite effectués par notre équipe, sur site ou à distance, le jour même."
              }
            },
            {
              "@type": "Question",
              "name": "IO Pay est-elle une solution sûre ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "IO Pay garantit une expérience de paiement sécurisée et vous protège du risque de fraude grâce à des protocoles de sécurité avancés."
              }
            },
            {
              "@type": "Question",
              "name": "Faut-il un équipement spécifique pour bénéficier d’IO Pay ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vous devez vous équiper au choix : de TPE compatibles Android (Pax ou Sunmi), de notre dernière génération de caisse (Nano, Move, Pro ou Max) avec SoftPos, ou de notre borne de commande intégrant le SoftPos."
              }
            },
            {
              "@type": "Question",
              "name": "En combien de temps l’argent arrive sur son compte ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pour les encaissements CB, Visa et Mastercard, vos fonds sont versés à J+1. Pour les autres paiements comme les tickets restaurants, le virement se fait selon votre contrat existant."
              }
            }
          ]
        }
      ]
    }
    </script>
    <style is:inline>

    	.volume-marquee__collection-wrapper {
        -webkit-animation: logoloop 90s linear infinite;
        -moz-animation: logoloop 90s linear infinite;
        -o-animation: logoloop 90s linear infinite;
    	}

    	.volume-marquee:hover .volume-marquee__collection-wrapper,
      .volume-marquee:focus-within .volume-marquee__collection-wrapper {
      	-webkit-animation-play-state: paused;
        -moz-animation-play-state: paused;
        -o-animation-play-state: paused;
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion) {
        .volume-marquee__collection-wrapper {
          -webkit-animation-play-state: paused;
          -moz-animation-play-state: paused;
          -o-animation-play-state: paused;
          animation-play-state: paused;
        }
      }

    	@-webkit-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-moz-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-o-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

    </style>
