    .faq-col-tab._1st {
      display: none !important;
    }

    /* hide moved content by default */
    .tab-mobile-home-grid .tab-faq-img-wrapper.v2 {
      display: none;
      margin-top: 12px;
      margin-bottom: 12px;
    }

    /* show only when the tab is active */
    .faq-tab-link.w--current .tab-mobile-home-grid .tab-faq-img-wrapper.v2 {
      display: block;
    }
  }

  @media screen and (min-width: 991px) {
    .tab-mobile-home-grid .tab-faq-img-wrapper.v2 {
      display: none !important;
    }
  }


  </style>
  </div>
  <Fragment slot="scripts">
    <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const items = Array.from(document.querySelectorAll('#expertise-link, .expertise-link'));

      items.forEach(function(orig) {
        if (!orig) return;
        const link = orig.getAttribute('data-link');
        if (!link) return;

        const block = document.createElement('div');
        block.className = 'discover-expertise w-inline-block';
        block.style.cursor = 'pointer';
        block.setAttribute('role', 'link');
        block.setAttribute('tabindex', '0');


        block.id = orig.id;

        while (orig.firstChild) {
          block.appendChild(orig.firstChild);
        }

        function navigate(evt) {
          if (evt) {
            try { evt.stopPropagation(); } catch (e) {}
            try { evt.preventDefault(); } catch (e) {}
          }
          window.location.href = link;
        }

        block.addEventListener('click', navigate);
        block.addEventListener('pointerdown', function (e) { e.stopPropagation(); });
        block.addEventListener('touchstart', function (e) { e.stopPropagation(); });
        block.addEventListener('keydown', function (e) {
          const k = e.key || e.keyCode;
          if (k === 'Enter' || k === ' ' || k === 'Spacebar' || k === 13 || k === 32) {
            e.preventDefault();
            navigate(e);
          }
        });

        orig.parentNode.replaceChild(block, orig);
      });
    });
    </script>
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js" is:inline></script>
    <script src="https://weblocks.io/library.js" is:inline></script>
    <script src="https://weblocks.io/script-66-529.js" is:inline></script>
    <script is:inline>
        function setupWebflowTabsForMobile() {
            if (window.innerWidth <= 990) {
                const tabLinks = document.querySelectorAll(".faq-tab-link");
                const tabPanes = document.querySelectorAll(".w-tab-pane");
                tabLinks.forEach((tabLink) => {
                    if (
                        tabLink.querySelector(
                            ".tab-mobile-home-grid .tab-faq-img-wrapper.v2",
                        )
                    ) {
                        return;
                    }
                    const panId = tabLink.getAttribute("aria-controls");
                    const pane = Array.from(tabPanes).find((p) => p.id == panId);
                    if (pane) {
                        const wrapper = pane.querySelector(".tab-faq-img-wrapper.v2");
                        const targetGrid = tabLink.querySelector(".tab-mobile-home-grid");
                        if (wrapper && targetGrid) {
                            targetGrid.appendChild(wrapper.cloneNode(true)); // move wrapper into the grid
                        }
                    }
                });
            }
        }
        Webflow.push(setupWebflowTabsForMobile);
        document.addEventListener("DOMContentLoaded", setupWebflowTabsForMobile);
        window.addEventListener("resize", setupWebflowTabsForMobile);
    </script>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            const menuLinks = document.querySelectorAll(
                "#custom-tabs-menu .homepage-tab-link",
            );
            const contents = document.querySelectorAll(
                ".homepage-tabs-content .faq-tabs-row-wrapper",
            );
            function showTab(targetId) {
                contents.forEach((c) => {
                    if (c.id === targetId) {
                        // Show + fade in
                        c.style.display = "block";
                        requestAnimationFrame(() => c.classList.add("active"));
                    } else {
                        // Fade out, then hide after transition
                        c.classList.remove("active");
                        c.style.display = "none";
                        // c.addEventListener("transitionend", function handler() {
                        //   if (!c.classList.contains("active")) {
                        //     c.style.display = "none";
                        //   }
                        //   c.removeEventListener("transitionend", handler);
                        // });
                    }
                });
            }
            menuLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    menuLinks.forEach((l) => l.classList.remove("active"));
                    link.classList.add("active");
                    const targetId = link.id.replace("-menu", "");
                    showTab(targetId);
                });
            });
            // Initialize: show only the active one on load
            const activeLink = document.querySelector(
                "#custom-tabs-menu .homepage-tab-link.active",
            );
            if (activeLink) {
                const targetId = activeLink.id.replace("-menu", "");
                showTab(targetId);
            }
        });
    </script>
  </Fragment>
</BaseLayout>
