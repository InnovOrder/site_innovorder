    </div><div class="section-base">
      <div class="container-1280">
        <div class="flex-48">
          <div class="flex-16 flex-center">
            <h2 class="_40px-head text-align-center max-width-550">Quand les fondateurs d’Innovorder <span class="gradient-text">parlent d’avenir.</span></h2>
            <p class="text-size-18px text-align-center max-width-750">Parce qu’un restaurant, c’est avant tout une aventure humaine, nous faisons de l’IA un allié discret qui libère du temps pour l’essentiel : l’expérience client.</p>
          </div>
          <div class="ai-quote-wrap">
            <div class="quote-img-wrap"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/68e9241b9577c619b9fe34f7_J%C3%A9r%C3%B4me%20PP%201.avif" loading="lazy" alt class="quote-img"></div>
            <div class="flex-20 flex-left">
              <div class="ai-quote-icon w-embed"><svg width="45" height="35" viewBox="0 0 45 35" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M13.95 0.25L21.9 3.1C16.5 10.75 12.3 21.55 12.45 34.75H0C1.35 17.8 7.95 5.2 13.95 0.25ZM36.3 0.25L44.25 3.1C38.85 10.75 34.65 21.55 34.8 34.75H22.35C23.7 17.8 30.3 5.2 36.3 0.25Z" fill="url(#paint0_linear_478_37218)"/>
  <defs>
  <linearGradient id="paint0_linear_478_37218" x1="1.67964e-09" y1="25.7621" x2="44.25" y2="25.7425" gradientUnits="userSpaceOnUse">
  <stop stop-color="#FFB266"/>
