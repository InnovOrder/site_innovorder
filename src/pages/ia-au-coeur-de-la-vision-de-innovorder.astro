              <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js" is:inline></script>
              <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {

      const phoneInput = document.querySelector("#phone");
      if (!phoneInput) return;

      const form = phoneInput.closest("form");
      const submitButton = form ? form.querySelector('[type="submit"]') : null;
      const errorMessage = document.querySelector("#phone-error");

      const iti = window.intlTelInput(phoneInput, {
          initialCountry: "fr",
          separateDialCode: true,
          utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js"
      });



      function isIOS() {
          return (
              /iPad|iPhone|iPod/.test(navigator.userAgent) ||
              (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)
          );
      }


      function positionDropdownIOS() {

          if (!isIOS()) return;

          const list = document.querySelector(".iti__country-list");
          if (!list) return;

          const rect = phoneInput.getBoundingClientRect();

          list.style.position = "fixed";
          list.style.left = rect.left + "px";
          list.style.top = (rect.bottom + 6) + "px";
          list.style.width = rect.width + "px";
          list.style.maxHeight = "250px";
          list.style.zIndex = "999999";
      }

      document.addEventListener("click", function(e){
          if(e.target.closest(".iti__selected-flag")){
              setTimeout(positionDropdownIOS,30);
          }
      });

      window.addEventListener("resize",positionDropdownIOS);
      window.addEventListener("scroll",positionDropdownIOS);



      function validatePhone(){

          if (!errorMessage) return true;

          if (phoneInput.value.trim() === "") {
              errorMessage.style.display = "none";
              return false;
          }

          if (iti.isValidNumber()) {
              errorMessage.style.display = "none";
              return true;
          }

          errorMessage.style.display = "flex";
          return false;
      }

      phoneInput.addEventListener("input", validatePhone);
      phoneInput.addEventListener("blur", validatePhone);



      function updateSubmitState() {

          if (!form || !submitButton) return;

          const requiredFields = form.querySelectorAll("input[required], select[required]");

          let allFilled = true;

          requiredFields.forEach((field) => {

              if (field.id === "phone") return;

              if (!field.value || !field.checkValidity()) {
                  allFilled = false;
              }

          });

          const phoneOk =
              phoneInput.value.trim() !== "" &&
              iti.isValidNumber();

          const formValid = allFilled && phoneOk;

          submitButton.disabled = !formValid;
          submitButton.style.opacity = formValid ? "1" : "0.5";
          submitButton.style.cursor = formValid ? "pointer" : "not-allowed";
      }

      form.querySelectorAll("input[required], select[required]").forEach((el) => {
          el.addEventListener("input", updateSubmitState);
          el.addEventListener("change", updateSubmitState);
      });

      phoneInput.addEventListener("input", updateSubmitState);
      phoneInput.addEventListener("countrychange", updateSubmitState);
      phoneInput.addEventListener("blur", updateSubmitState);

      updateSubmitState();



      if (form) {

          form.addEventListener("submit", function (e) {

              if (!validatePhone()) {
                  e.preventDefault();
                  return;
              }

              phoneInput.value = iti.getNumber();

          });

      }

  });
  </script>
