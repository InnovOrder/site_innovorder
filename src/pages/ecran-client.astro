          ]
        },
        {
          "@type": "Product",
          "@id": "https://www.innovorder.com/ecran-client#product",
          "name": "Écran d'affichage client Innovorder",
          "description": "Système d'appel client pour informer en temps réel de l'état des commandes. Réduit l'attente et organise le flux de retrait des commandes.",
          "image": "https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/68502db0cd7493893969333a_Deux%20modes%20d%E2%80%99utilisation%20selon%20votre%20organisation.avif",
          "brand": {
            "@type": "Brand",
            "name": "Innovorder"
          },
          "manufacturer": {
            "@type": "Organization",
            "@id": "https://www.innovorder.com/#organization",
            "name": "Innovorder",
            "url": "https://www.innovorder.com"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "442"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://www.innovorder.com/ecran-client#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Est-ce que l’écran d’affichage client peut fonctionner seul, sans écran de production ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Non, l’écran d’affichage client nécessite impérativement un écran de production pour fonctionner. C'est l'écran de production qui permet de suivre l’avancée des commandes en cuisine et de déclencher l’affichage automatique du statut 'prête' sur l’écran client."
              }
            },
            {
              "@type": "Question",
              "name": "Est-ce que l’écran d’affichage client affiche toutes les commandes ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Oui, l’écran d’affichage client peut afficher toutes les commandes enregistrées, quel que soit le canal de vente (caisse, borne, commande en ligne) ou le mode de consommation (sur place, à emporter, livraison). Vous pouvez filtrer l'affichage selon vos besoins spécifiques."
              }
            }
          ]
        }
      ]
    }
    </script>
    <style is:inline>

    	.volume-marquee__collection-wrapper {
        -webkit-animation: logoloop 90s linear infinite;
        -moz-animation: logoloop 90s linear infinite;
        -o-animation: logoloop 90s linear infinite;
    	}

    	.volume-marquee:hover .volume-marquee__collection-wrapper,
      .volume-marquee:focus-within .volume-marquee__collection-wrapper {
      	-webkit-animation-play-state: paused;
        -moz-animation-play-state: paused;
        -o-animation-play-state: paused;
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion) {
        .volume-marquee__collection-wrapper {
          -webkit-animation-play-state: paused;
          -moz-animation-play-state: paused;
          -o-animation-play-state: paused;
          animation-play-state: paused;
        }
      }

    	@-webkit-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-moz-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-o-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

    </style>
