---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavbarEn from '@/components/NavbarEn.astro';
import FooterEn from '@/components/FooterEn.astro';

export async function getStaticPaths() {
  const entries = await getCollection("en-integrations");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
// Champs variables de la page (texte, attributs, fragments HTML), issus du CMS Webflow.
const d = entry.data.fields;
---
<BaseLayout {...entry.data.seo}>
  <Fragment slot="head">
    <!-- Weglot -->
    <Fragment set:html={d["head:field-script"]} />
    <link href={d["head:link-href"]} hreflang="fr" rel="alternate">
    <link href={d["link-href-2"]} hreflang="en" rel="alternate">
  </Fragment>
  <div class="overflow-hidden"><div class="gtm-embed w-embed"></div><NavbarEn /><div class="section-hero-n integrations">
      <div class="container-1280">
        <div class="wrap-hero-integrations">
          <div class="container-integrations-hero">
            <h1 data-w-id="0023fc2a-089a-42ed-19b2-10cc487f3f34" style="opacity:0" class="title-00 kiosk is-white _0">{d["title-00"]}</h1>
            <p class="text-17px expertise is-white _0">{d["text-17px"]}</p>
