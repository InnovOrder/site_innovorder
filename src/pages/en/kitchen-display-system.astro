<BaseLayout {...seo}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.innovorder.com/en/kitchen-display-system#webpage","url":"https://www.innovorder.com/en/kitchen-display-system","name":"Kitchen display system (KDS) & restaurant production screen | Innovorder","description":"Optimize your kitchen production with the KDS Innovorder. Eliminate paper tickets, reduce errors, and speed up order delivery.","breadcrumb":{"@id":"https://www.innovorder.com/en/kitchen-display-system#breadcrumb"},"mainEntity":{"@id":"https://www.innovorder.com/en/kitchen-display-system#product"}},{"@type":"BreadcrumbList","@id":"https://www.innovorder.com/en/kitchen-display-system#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.innovorder.com/en"},{"@type":"ListItem","position":2,"name":"Kitchen display","item":"https://www.innovorder.com/en/kitchen-display-system"}]},{"@type":"Product","@id":"https://www.innovorder.com/en/kitchen-display-system#product","name":"Innovorder kitchen display system (KDS)","description":"Smart kitchen display system for managing orders in real time. Dispatching by station, tracking preparation times, and order history.","image":"https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/681b26a6c8dfd9ad37e382e1_Group%20920.avif","brand":{"@type":"Brand","name":"Innovorder"},"manufacturer":{"@type":"Organization","@id":"https://www.innovorder.com/en/#organization","name":"Innovorder","url":"https://www.innovorder.com/en"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","bestRating":"5","worstRating":"1","ratingCount":"442"}},{"@type":"FAQPage","@id":"https://www.innovorder.com/en/kitchen-display-system#faq","mainEntity":[{"@type":"Question","name":"What's the difference between a kitchen screen, a production screen, a KDS and a display screen?","acceptedAnswer":{"@type":"Answer","text":"There aren't any! Kitchen displays, production displays, KDS (Kitchen Display Systems), and display screens all serve the same purpose: to make life easier in the kitchen and help organizers stay organized."}},{"@type":"Question","name":"How much does a kitchen screen cost?","acceptedAnswer":{"@type":"Answer","text":"Innovorder offers subscriptions to its solutions. To find out the price of a production screen, contact an Innovorder advisor to receive a customized quote tailored to your restaurant."}},{"@type":"Question","name":"How do you install a production screen in your restaurant kitchen?","acceptedAnswer":{"@type":"Answer","text":"Our experts take care of everything! Our team will visit your restaurant to install, configure and train your operators in the use of the production screens."}},{"@type":"Question","name":"Why install a kitchen monitor in your restaurant?","acceptedAnswer":{"@type":"Answer","text":"A kitchen display screen increases team productivity, streamlines restaurant organization, and simplifies the daily tasks of food preparers, resulting in considerable efficiency gains."}},{"@type":"Question","name":"How to choose the right kitchen screen?","acceptedAnswer":{"@type":"Answer","text":"Several criteria must be checked: kitchen size, number of workstations to be equipped, sales volume, budget, functionality, and ease of use. Contact us for expert advice!"}},{"@type":"Question","name":"How many tickets do you need a kitchen screen for?","acceptedAnswer":{"@type":"Answer","text":"A kitchen display is recommended for 70/80 tickets per day or more. We then recommend one additional display for every 80 tickets to ensure total fluidity."}},{"@type":"Question","name":"What happens if I make a click error?","acceptedAnswer":{"@type":"Answer","text":"Our system includes an order history feature that allows you to reinstate an order that was accidentally canceled with a single click."}},{"@type":"Question","name":"Can you use several production screens to distribute orders?","acceptedAnswer":{"@type":"Answer","text":"Yes, it is possible to distribute orders between several screens according to production stations (grill, fries, pizza, etc.) for optimal task organization."}}]}]}</script>
    <style is:inline>

    	.volume-marquee__collection-wrapper {
        -webkit-animation: logoloop 90s linear infinite;
        -moz-animation: logoloop 90s linear infinite;
        -o-animation: logoloop 90s linear infinite;
    	}

    	.volume-marquee:hover .volume-marquee__collection-wrapper,
      .volume-marquee:focus-within .volume-marquee__collection-wrapper {
      	-webkit-animation-play-state: paused;
        -moz-animation-play-state: paused;
        -o-animation-play-state: paused;
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion) {
        .volume-marquee__collection-wrapper {
          -webkit-animation-play-state: paused;
          -moz-animation-play-state: paused;
          -o-animation-play-state: paused;
          animation-play-state: paused;
        }
      }

    	@-webkit-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-moz-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-o-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

    </style>
