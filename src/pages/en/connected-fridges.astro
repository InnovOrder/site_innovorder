    <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.innovorder.com/en/connected-fridges#webpage","url":"https://www.innovorder.com/en/connected-fridges","name":"Frigo connecté pour entreprise et restauration collective | Innovorder","description":"Offer a 24/7 catering solution with the Innovorder connected refrigerator. Secure self-service, contactless payment, and simplified management.","breadcrumb":{"@id":"https://www.innovorder.com/en/connected-fridges#breadcrumb"},"mainEntity":{"@id":"https://www.innovorder.com/en/connected-fridges#product"}},{"@type":"BreadcrumbList","@id":"https://www.innovorder.com/en/connected-fridges#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.innovorder.com/en"},{"@type":"ListItem","position":2,"name":"Frigo connecté","item":"https://www.innovorder.com/en/connected-fridges"}]},{"@type":"Product","@id":"https://www.innovorder.com/en/connected-fridges#product","name":"Frigo Connecté Innovorder","description":"Standalone catering solution for businesses. Identification by badge or credit card, automatic product detection, and secure payment.","image":"https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/68af27f5f24a84bcdf695326_Group%20767.avif","brand":{"@type":"Brand","name":"Innovorder"},"manufacturer":{"@type":"Organization","@id":"https://www.innovorder.com/en/#organization","name":"Innovorder","url":"https://www.innovorder.com/en"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","bestRating":"5","worstRating":"1","ratingCount":"442"}},{"@type":"FAQPage","@id":"https://www.innovorder.com/en/connected-fridges#faq","mainEntity":[{"@type":"Question","name":"Qu’est-ce qu’un frigo connecté d’entreprise ?","acceptedAnswer":{"@type":"Answer","text":"A connected company refrigerator is specially designed for corporate catering. Installed in cafeterias or coworking spaces, it offers employees healthy meals prepared daily on a self-service basis."}},{"@type":"Question","name":"Comment fonctionne un frigo connecté d’entreprise ?","acceptedAnswer":{"@type":"Answer","text":"The guest scans their badge, bank card, or digital meal voucher to open the refrigerator. They select their items and close the door, which automatically completes the purchase."}},{"@type":"Question","name":"Comment installer un frigo connecté dans son entreprise ?","acceptedAnswer":{"@type":"Answer","text":"All you need is a power outlet and an Internet connection—no installation work required. Innovorder takes care of the entire installation and configuration process."}},{"@type":"Question","name":"Quelle est la surface nécessaire pour installer un frigo connecté ?","acceptedAnswer":{"@type":"Answer","text":"A connected refrigerator takes up barely more space than a conventional refrigerator. Contact an Innovorder advisor for the exact dimensions of each model."}},{"@type":"Question","name":"Quelle est la capacité d’un frigo connecté d’entreprise ?","acceptedAnswer":{"@type":"Answer","text":"The average capacity is 50 place settings, varying depending on the type of containers and the refrigerator model chosen."}},{"@type":"Question","name":"Quels sont les avantages d’un frigo connecté pour une entreprise ?","acceptedAnswer":{"@type":"Answer","text":"It allows you to diversify your food service offerings around the clock, optimize inventory management in real time, and reduce service staff requirements."}},{"@type":"Question","name":"Quels types de produits puis-je proposer dans un frigo connecté ?","acceptedAnswer":{"@type":"Answer","text":"You can offer a wide range of products: prepared meals, snacks, drinks, desserts, salads, and sandwiches."}},{"@type":"Question","name":"Comment s’effectue le paiement sur le frigo connecté ?","acceptedAnswer":{"@type":"Answer","text":"Payment is 100% secure and contactless via credit card, mobile (Apple Pay, Google Pay), or company badge."}}]}]}</script>
