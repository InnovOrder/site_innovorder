  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.innovorder.com/en/tpe-restaurant#webpage","url":"https://www.innovorder.com/en/tpe-restaurant","name":"Restaurant payment terminal: touchscreen electronic payment terminal | Innovorder","description":"Optimize your cash receipts with Innovorder payment terminals. Payment terminals connected to your cash register, tip management, and acceptance of all meal vouchers.","breadcrumb":{"@id":"https://www.innovorder.com/en/tpe-restaurant#breadcrumb"},"mainEntity":{"@id":"https://www.innovorder.com/en/tpe-restaurant#product"}},{"@type":"BreadcrumbList","@id":"https://www.innovorder.com/en/tpe-restaurant#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.innovorder.com/en"},{"@type":"ListItem","position":2,"name":"Restaurant payment terminal","item":"https://www.innovorder.com/en/tpe-restaurant"}]},{"@type":"Product","@id":"https://www.innovorder.com/en/tpe-restaurant#product","name":"Innovorder payment terminal","description":"Portable or fixed POS terminal connected in real time to your cash register software. Eliminates double entry and accepts all modern payment methods.","image":"https://cdn.prod.website-files.com/63f501f2fcfc59779719f99c/692ed183df35dd52abab0f97_tpe%20hero.avif","brand":{"@type":"Brand","name":"Innovorder"},"manufacturer":{"@type":"Organization","@id":"https://www.innovorder.com/en/#organization","name":"Innovorder","url":"https://www.innovorder.com/en"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","bestRating":"5","worstRating":"1","ratingCount":"442"}},{"@type":"FAQPage","@id":"https://www.innovorder.com/en/tpe-restaurant#faq","mainEntity":[{"@type":"Question","name":"Which payment cards or meal vouchers are accepted by Innovorder payment terminals?","acceptedAnswer":{"@type":"Answer","text":"With the IO Pay payment system, you can accept all types of payment: bank cards (CB, Visa, Mastercard, Amex), wallets (Apple Pay, Google Pay), and digital meal vouchers (Ticket Restaurant, Swile, etc.)."}},{"@type":"Question","name":"Do the POS terminals offered by Innovorder handle tips?","acceptedAnswer":{"@type":"Answer","text":"Yes, tips are managed seamlessly directly from the payment terminals (TPE)."}},{"@type":"Question","name":"What is the most suitable payment terminal for my restaurant?","acceptedAnswer":{"@type":"Answer","text":"The Innovorder POS terminal, portable or fixed, connects to your cash register to eliminate double entry. Whatever your organization, we offer terminals tailored to the needs of your teams for fast checkout."}},{"@type":"Question","name":"Are Innovorder POS systems suitable for managing multiple restaurants?","acceptedAnswer":{"@type":"Answer","text":"Yes. Centralized monitoring gives you unified control over all your transactions. From our back office, you can manage the performance of your various restaurants and identify establishments that require special attention."}},{"@type":"Question","name":"How do I set up and use my Innovorder payment terminal with IO Pay?","acceptedAnswer":{"@type":"Answer","text":"An IO Pay electronic payment contract must first be set up. Installation and configuration are then carried out directly by our team, either on-site or remotely, on the same day."}}]}]}</script>
    <style is:inline>

    	.volume-marquee__collection-wrapper {
        -webkit-animation: logoloop 90s linear infinite;
        -moz-animation: logoloop 90s linear infinite;
        -o-animation: logoloop 90s linear infinite;
    	}

    	.volume-marquee:hover .volume-marquee__collection-wrapper,
      .volume-marquee:focus-within .volume-marquee__collection-wrapper {
      	-webkit-animation-play-state: paused;
        -moz-animation-play-state: paused;
        -o-animation-play-state: paused;
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion) {
        .volume-marquee__collection-wrapper {
          -webkit-animation-play-state: paused;
          -moz-animation-play-state: paused;
          -o-animation-play-state: paused;
          animation-play-state: paused;
        }
      }

    	@-webkit-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-moz-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-o-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

    </style>
