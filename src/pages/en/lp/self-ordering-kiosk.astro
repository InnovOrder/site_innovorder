    <section id="logo" class="section-logo">
      <div class="page-padding">
        <div class="container-large">
          <div class="padding-vertical padding-xxlarge">
            <div class="logo_content-wrapper">
              <h2 class="heading-large">+ <span class="highlight-orange"> More than 800 brands</span> trust us</h2>
              <div class="logo_component">
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc59441219fd45_33457455-big-f-logos-source-fr-02-3_105e04m000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc5972ab19fd52_0d16694c-la-mie-caline-logo-hd_107804y000000000000028.webp" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc5931b919fd47_0298347c-amorino_106404s000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc599e8819fd4d_9a9e7bf2-logo-boucherie-2021_107804a000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc5936bd19fd51_a7c8a17c-waffle-logo_106k06i000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc59242419fd42_4fa784bb-courtepaille_105y04u000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc592e6f19fd3d_495ed218-logo-quick-100px_1000000000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc59c6ab19fd3c_2c6c9f05-ankka-logo_106m06k000000000000028.png" loading="lazy" alt class="logo_img"></div>
                <div class="logo1_wrapper"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc592c5e19fd44_2ddaf0b0-bagel-corner-logo_106606206604q00000o028.png" loading="lazy" alt class="logo_img"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
