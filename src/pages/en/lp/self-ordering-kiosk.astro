---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  "title": "Innovorder | Fast food & restaurant ordering station",
  "description": "Optimize your point of sale flow, improve the customer experience with the most advanced kiosks on the market for fast food and restaurants.",
