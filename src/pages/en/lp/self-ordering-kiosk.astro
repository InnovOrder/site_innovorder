              <p class="text-lead load-2nd"><span class="text-highlight-orange"><strong class="highlight-orange">Boost your restaurant's results</strong></span> and increase your revenue with a new sales channel! <br><br>Less waiting, more receipts and <span class="text-highlight-orange"><strong class="highlight-orange">more customers!</strong></span><br></p>
              <div class="div-button"><a href="#logo" class="button-white-outlined-3 w-inline-block">
                  <div class="text-block-12">DISCOVER</div>
                  <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f3fcfc591d4b19ffb0_down-arrow.svg" alt class="button-arrow-2">
                  <div class="preloader"><img src="https://cdn.prod.website-files.com/60d19e0a5d03bd07faa03154/60d19e0b5d03bd8646a03320_25.gif" alt class="preloader-image"></div>
                </a></div>
            </div>
            <div id="w-node-_2e0db9ab-f3b9-ffdc-7d6d-88849ef5401b-6643cbb0" class="laptop-wrapper load-2nd">
              <div class="form_wrapper">
                <div class="title-centered-wrapper-2"></div>
                <div class="long-form w-form">
                  <form id="wf-form-Formulaire-de-contact" name="wf-form-Formulaire-de-contact" data-name="Formulaire de contact" redirect="https://www.innovorder.fr/thank-you" data-redirect="https://www.innovorder.fr/thank-you" method="get" data-wf-page-id="6493777d655aea5e6643cbb0" data-wf-element-id="78267b02-596d-0752-f55d-922eb161860d" data-turnstile-sitekey="0x4AAAAAAAQTptj2So4dx43e">
                    <div class="w-layout-grid long-form-grid">
                      <div>
                        <div class="w-layout-grid text-field-grid">
                          <input class="text-field-underlined-2 w-input" maxlength="256" name="firstname-2" data-name="Firstname 2" placeholder="First name* (if applicable)" type="text" id="firstname-2" required>
                          <input class="text-field-underlined-2 w-input" maxlength="256" name="lastname-2" data-name="Lastname 2" placeholder="Name" type="text" id="lastname-2" required>
                          <input class="text-field-underlined-2 w-node-_78267b02-596d-0752-f55d-922eb161864f-6643cbb0 w-input" maxlength="256" name="company-2" data-name="Company 2" placeholder="Company" type="text" id="company-2" required>
                          <input class="text-field-underlined-2 w-input" maxlength="256" name="Email-2" data-name="Email 2" placeholder="Email*" type="email" id="Email-2" required>
                          <select id="country_innovorder-2" name="country_innovorder-2" data-name="Country Innovorder 2" required class="select-field-underlined-2 w-select">
                            <option value>Type of restoration</option>
                            <option value="Restauration rapide">Fast food</option>
                            <option value="Restauration traditionnelle">Traditional catering</option>
                            <option value="Restauration collective">Collective catering</option>
                          </select>
                          <input class="text-field-underlined-2 w-input" maxlength="256" name="phone-2" data-name="Phone 2" placeholder="Phone number* (if applicable)" type="tel" id="phone-2" required>
                        </div>
                      </div>
                    </div>
                    <div class="w-embed"><input type="hidden" class="utm_source" placeholder="utm_source" name="utm_source">
  <input type="hidden" class="utm_medium" placeholder="utm_medium" name="utm_medium">
  <input type="hidden" class="utm_campaign" placeholder="utm_campaign" name="utm_campaign"></div>
                    <input type="submit" data-wait="Envoi en cours..." class="button-icon-3 contact-mobile-button w-button" value="Send">
                    <div>
                      <div class="text-gray-1 text-form">*required fields<br>We will never share your information with third parties. <a href="/en/terms-and-conditions">See our legal notice for more information.</a><br></div>
                    </div>
                  </form>
                  <div class="success-2 w-form-done">
                    <div>Thank you! Our team will contact you as soon as possible.</div>
                  </div>
                  <div class="error-2 w-form-fail">
                    <div>Oops! Something went wrong.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
