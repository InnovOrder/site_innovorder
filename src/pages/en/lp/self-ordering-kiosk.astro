  </Fragment>
  <div class="page-wrapper">
    <div class="gtm-embed w-embed"></div>
    <div data-collapse="medium" data-animation="default" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="nav_component w-nav">
      <div class="navbar_container">
        <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f3fcfc59749519ffbc_Innovorder-LogoVector.svg" width="268" alt="innovorder" class="navbar_logo">
        <a href="#contact" class="navbar_button hide-desktop w-inline-block">
          <div class="text-block-32">Get my quote</div>
        </a>
        <div class="navbar-functions-center">
          <nav role="navigation" class="nav-menu-center-2 w-nav-menu">
            <div class="w-layout-grid navigation-bar_content-center">
              <div class="w-layout-grid navbar_content-center_wrapper"><a href="#borne" class="navbar_link w-inline-block">
                  <div class="dropdown-title">Connected terminal</div>
                </a><a href="#paiement" class="navbar_link w-inline-block">
                  <div class="dropdown-title">Easy payments </div>
                </a><a href="#engagements" class="navbar_link w-inline-block">
                  <div class="dropdown-title">Commitments</div>
                </a><a href="#avis" class="navbar_link w-inline-block">
                  <div class="dropdown-title">Notice</div>
                </a><a href="#faq" class="navbar_link w-inline-block">
                  <div class="dropdown-title">FAQ</div>
                </a></div>
              <a href="tel:+33186954983" class="dropdown-toggle-nav-2 phone-link w-inline-block"></a>
            </div>
            <div class="menu-button-wrapper"><a href="#contact" class="navbar_button w-inline-block">
                <div class="text-block-32">Get my quote</div>
              </a></div>
