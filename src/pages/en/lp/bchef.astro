---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  "title": "Boost your franchise with Bchef - Innovorder",
  "lang": "en",
  "htmlAttrs": {
    "data-wf-page": "6493777d655aea5e6643cb98"
  },
  "bodyClass": "body",
  "webflowScripts": [
    {
      "src": "/assets/d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js",
      "type": "text/javascript",
      "integrity": "sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.4621b44054c4cc64.js",
      "type": "text/javascript",
      "integrity": "sha384-aghwvml5rig/T7e4zosxno6oA1Egc3cKPM6FP9ti9TCQkAoo+GH+XXh7xNn/M+6r",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.b693920686705a26.js",
      "type": "text/javascript",
      "integrity": "sha384-C/wFs2yjYA9jOcYLm4wK5l9pvcKosdzrrEqod/82XTjVD5Sa5FyXRmbPrHN7uuct",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.81c8caa2.7a583d2f84404f74.js",
      "type": "text/javascript",
      "integrity": "sha384-DJVlwW9hLkiHqUOtjKtqn5a4YlqRnDc0Qur0U7MOnZJttoySvb0C7QVV3p98mPpb",
      "crossorigin": "anonymous"
    }
  ],
  "alternates": {
    "fr": "https://www.innovorder.com/lp/bchef",
    "en": "https://www.innovorder.com/en/lp/bchef"
  }
};
---
<BaseLayout {...seo}>
  <div class="section-hero-ebook lp">
    <div class="container-1280">
      <div class="bg-hero-ebook"></div>
      <div class="padding">
        <div class="ebook-inner-hero-block">
          <div id="w-node-_119451dc-6d2d-1720-0e5b-a988c1c09c0f-6643cb98" class="block-hero-ebook-inner">
            <h1 id="w-node-_119451dc-6d2d-1720-0e5b-a988c1c09c10-6643cb98" class="title-00 ebook-hero white">Boost your restaurant like BCHEF!</h1>
            <div class="subtitle-hero-ebook-inner">Discover how Stéphanie, Peggy and Damien, BCHEF franchisees, have increased their sales and are making between 600K and 1M€ in turnover!</div>
          </div>
          <div id="w-node-_119451dc-6d2d-1720-0e5b-a988c1c09c14-6643cb98" class="ebook-hero-inner-contact-block">
            <div class="gradient-block">
              <div id="form" class="hero-block-form-ebook">
                <div class="title-left-side-wrapper ebook-inner">
                  <div class="border-gradient-div ebook"></div>
                  <h2 class="title50px ebook-inner-form">Your guide in 1 click <span class="gradient-text">!</span></h2>
                </div>
                <div class="form-ebook w-form">
                  <form id="wf-form-LP-Bchef" name="wf-form-LP-Bchef" data-name="LP-Bchef" method="get" class="form-ebook-flex" data-wf-page-id="6493777d655aea5e6643cb98" data-wf-element-id="119451dc-6d2d-1720-0e5b-a988c1c09c1e" data-turnstile-sitekey="0x4AAAAAAAQTptj2So4dx43e">
                    <div class="w-embed"><input type="hidden" class="utm_source" placeholder="utm_source" name="utm_source">
  <input type="hidden" class="utm_medium" placeholder="utm_medium" name="utm_medium">
  <input type="hidden" class="utm_campaign" placeholder="utm_campaign" name="utm_campaign"></div>
                    <input class="text-field-ebook-signup w-input" maxlength="256" name="Entreprise" data-name="Entreprise" placeholder="Company" type="text" id="Entreprise">
                    <div class="title-nombre">Number of sales outlets</div>
                    <div class="bullets-form"><label class="checkbox-field w-radio">
                        <div class="w-form-formradioinput w-form-formradioinput--inputType-custom checkbox-3 w-radio-input"></div>
                        <input id="1-3" type="radio" name="Nombre-de-points-de-vente" data-name="Nombre de points de vente" style="opacity:0;position:absolute;z-index:-1" value="1 à 3">
                        <span class="checkbox-label w-form-label" for="1-3">1 to 3</span>
                      </label><label class="checkbox-field w-radio">
                        <div class="w-form-formradioinput w-form-formradioinput--inputType-custom checkbox-3 w-radio-input"></div>
                        <input type="radio" data-name="Nombre de points de vente" id="4-10-11" name="Nombre-de-points-de-vente" style="opacity:0;position:absolute;z-index:-1" value="4 à 10">
                        <span class="checkbox-label w-form-label" for="4-10-11">4 to 10</span>
                      </label><label class="checkbox-field w-radio">
                        <div class="w-form-formradioinput w-form-formradioinput--inputType-custom checkbox-3 w-radio-input"></div>
                        <input type="radio" data-name="Nombre de points de vente" id="10-11" name="Nombre-de-points-de-vente" style="opacity:0;position:absolute;z-index:-1" value="+10">
                        <span class="checkbox-label w-form-label" for="10-11">+10</span>
                      </label></div>
                    <input class="text-field-ebook-signup w-input" maxlength="256" name="Pr-nom" data-name="Prénom" placeholder="First name" type="text" id="Pr-nom" required>
                    <input class="text-field-ebook-signup w-input" maxlength="256" name="Nom" data-name="Nom" placeholder="Name" type="text" id="Nom" required>
                    <input class="text-field-ebook-signup w-input" maxlength="256" name="Num-ro-de-t-l-phone" data-name="Numéro de téléphone" placeholder="Phone number " type="tel" id="Num-ro-de-t-l-phone" required>
                    <input class="text-field-ebook-signup w-input" maxlength="256" name="E-mail" data-name="E-mail" placeholder="E-mail " type="email" id="E-mail" required>
                    <div class="text-block-112"><em>*required fields<br>We will never share your information with third parties.<br>See our </em><a href="/en/terms-and-conditions" target="_blank" class="link"><em>legal notice</em></a><em> for more information.</em></div>
                    <img width="269" alt src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/64248f5e64808d84729a1dc1_64248abc887b80264b759be5_magasine%20ouvert%202%20pages%20face%201.avif" loading="lazy" class="image-form-ebook">
                    <input type="submit" data-wait="Please wait..." class="button-icon-hp-2 _2 w-button" value="Download the guide">
                  </form>
                  <div class="success-message w-form-done">
                    <div class="rt-thank-you w-richtext">
                      <h1>Your white paper is available 👇</h1>
                      <h2>Boost your restaurant like BChef!</h2>
                      <p><strong>Thank you!</strong></p>
                      <p><a href="https://5696087.fs1.hubspotusercontent-na1.net/hubfs/5696087/Livres%20blancs/Boostez%20votre%20franchise%20comme%20BCHEF.pdf" target="_blank">Download</a></p>
                      <p>Thank you <a href="/en" target="_blank">Innovorder</a> team</p>
                    </div>
                  </div>
                  <div class="w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="section-2-ebook">
    <div class="container-1280 _88rel">
      <div class="ebook-inner-hero-block space">
        <div class="title-left-side-wrapper ebook-exclusif-mobile">
          <div class="border-gradient-div ebook"></div>
          <h2 class="title50px ebook-inner-form">Exclusive testimony <span class="innov-pink">!</span></h2>
        </div>
        <div id="w-node-e0d546d4-dc2f-bfae-9421-8c8b2b7ffc65-6643cb98" class="temoignage-flex">
          <div id="w-node-e0d546d4-dc2f-bfae-9421-8c8b2b7ffc66-6643cb98" class="block-hero-ebook-inner flex">
            <div>
              <div class="title-left-side-wrapper ebook-exclusif">
                <div class="border-gradient-div ebook"></div>
                <h2 class="title50px ebook-inner-form">Exclusive testimony <span class="innov-pink">!</span></h2>
              </div>
              <div class="rt-ebook w-richtext">
                <p>Julien Perret, <strong>founder of BCHEF</strong>, shares his vision on the <strong>digitalization</strong> of fast food franchises in France.</p>
              </div>
            </div>
            <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc593a0019fd99_logo%20bchef.webp" loading="lazy" alt class="temoignage-img">
          </div>
        </div>
      </div>
      <div class="ebook-inner-hero-block2 bchef">
        <div class="title-left-side-wrapper expertise">
          <div class="border-gradient-div ebook"></div>
          <h2 class="title50px ebook-inner-form">In this guide, you will discover <span class="innov-pink">:</span></h2>
        </div>
        <div class="_3x1-grid-ebook">
          <div id="w-node-e0d546d4-dc2f-bfae-9421-8c8b2b7ffc84-6643cb98" class="block-ebook-decouvrirez">
            <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6415d26bf4c83f7ffff03b83_Picto%20euro.webp" loading="lazy" alt class="icon-ebook">
            <div class="rt-decouvrirez-block w-richtext">
              <p>How Stephanie <strong>increased her average shopping cart by 30%</strong> and her order volume by 13%.</p>
            </div>
          </div>
          <div id="w-node-e0d546d4-dc2f-bfae-9421-8c8b2b7ffc93-6643cb98" class="block-ebook-decouvrirez">
            <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6415d26a7dad6957b8ead94c_Picto%20horloge.avif" loading="lazy" alt class="icon-ebook">
            <div class="rt-decouvrirez-block w-richtext">
              <p>How Peggy <strong>saves 30 minutes</strong> a day on opening and closing her register.</p>
            </div>
          </div>
          <div id="w-node-e0d546d4-dc2f-bfae-9421-8c8b2b7ffca2-6643cb98" class="block-ebook-decouvrirez">
            <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6415d26bd03969a64e77828e_Picto%20fus%C3%A9e.avif" loading="lazy" alt class="icon-ebook">
            <div class="rt-decouvrirez-block w-richtext">
              <p>How Damien <strong>serves his customers in 6 minutes</strong> and why he is convinced by digital.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="section-2-cta">
    <div class="container-1280">
      <div id="w-node-_173d53d7-cdc6-f4dc-417d-0b91726f039a-6643cb98" class="gradient-block-cta">
        <div class="cta-ebook">
          <div class="rt-decouvrirez-block right w-richtext">
            <p>Digital is an essential lever to develop the activity of its restaurant. <strong>BCHEF</strong> reveals the strategy it has implemented in its establishments in exclusivity. </p>
            <p>Take advantage of their best advice now!</p>
          </div>
          <a href="#form" id="w-node-_173d53d7-cdc6-f4dc-417d-0b91726f03a9-6643cb98" class="button-icon-hp-2 _2 w-button">Download the guide</a>
          <div id="w-node-_173d53d7-cdc6-f4dc-417d-0b91726f03ab-6643cb98" class="gradient-block-cta-bg"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
