---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  "title": "Innovorder | Entrust us with your project",
  "description": "We support more than 3,000+ restaurant owners in their digital transformation.",
  "lang": "en",
  "htmlAttrs": {
    "data-wf-page": "6493777d655aea5e6643cc7e"
  },
  "bodyAttrs": {
    "ph-category": "main"
  },
  "webflowScripts": [
    {
      "src": "/assets/d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js",
      "type": "text/javascript",
      "integrity": "sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.4621b44054c4cc64.js",
      "type": "text/javascript",
      "integrity": "sha384-aghwvml5rig/T7e4zosxno6oA1Egc3cKPM6FP9ti9TCQkAoo+GH+XXh7xNn/M+6r",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.b693920686705a26.js",
      "type": "text/javascript",
      "integrity": "sha384-C/wFs2yjYA9jOcYLm4wK5l9pvcKosdzrrEqod/82XTjVD5Sa5FyXRmbPrHN7uuct",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.81c8caa2.7a583d2f84404f74.js",
      "type": "text/javascript",
      "integrity": "sha384-DJVlwW9hLkiHqUOtjKtqn5a4YlqRnDc0Qur0U7MOnZJttoySvb0C7QVV3p98mPpb",
      "crossorigin": "anonymous"
    }
  ],
  "alternates": {
    "fr": "https://www.innovorder.com/nous-contacter",
    "en": "https://www.innovorder.com/en/contact-us"
  }
};
---
<BaseLayout {...seo}>
  <div class="contact-form-page-wrapper">
    <div class="container-1280">
      <div class="contact-form-grid">
        <div class="flex-32">
          <img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/648ed522a137748e821902d0_innov-logo-w.svg" loading="lazy" width="256" alt class="logo-contact-form">
          <h1 class="h1-contact-form">The most comprehensive ecosystem for ambitious restaurant owners.</h1>
          <div class="features-wrap-contact">
            <div class="feature-row-contact">
              <div class="features-icon-contact-wrap">
                <div class="icon-svg-contact w-embed"><svg viewBox="0 0 24 24" fill="#fff" stroke="none"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.5 1.6 6.7L12 17.3 5.8 20.6l1.6-6.7L2.2 8.9l6.9-.6z"/></svg></div>
              </div>
              <div class="flex-4">
                <div class="text-20px text-color-white"><strong>4.9/5</strong></div>
                <div class="text-color-white">based on more than 600 customer reviews</div>
              </div>
            </div>
            <div class="feature-row-contact">
              <div class="features-icon-contact-wrap">
                <div class="icon-svg-contact w-embed"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg></div>
              </div>
              <div class="flex-4">
                <div class="text-20px text-color-white"><strong>Over 3,000 restaurants equipped</strong></div>
                <div class="text-color-white">in France and Europe</div>
              </div>
            </div>
            <div class="feature-row-contact">
              <div class="features-icon-contact-wrap">
                <div class="icon-svg-contact w-embed"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0116 0v2M4 14a2 2 0 002 2h1v-5H6a2 2 0 00-2 2zM20 14a2 2 0 01-2 2h-1v-5h1a2 2 0 012 2zM18 16v1a3 3 0 01-3 3h-3"/></svg></div>
              </div>
              <div class="flex-4">
                <div class="text-20px text-color-white"><strong>Customer Service 7 Days a Week</strong></div>
                <div class="text-color-white">personalized, community-based support</div>
              </div>
            </div>
          </div>
          <div class="flex-16">
            <div class="text-20px text-color-white"><strong>Leaders in the commercial and institutional food service industry trust us:</strong></div>
            <div class="logos-wrapper-contact"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6a3d4268f24ea94759555de8_download.png" loading="lazy" alt class="logo-img-contact"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6a3d42732cff7c2f23baa037_download.png" loading="lazy" alt class="logo-img-contact"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6a3d4279be11775b72b2ceb7_download.png" loading="lazy" alt class="logo-img-contact"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6a3d427f152ccb57450a00ae_download.webp" loading="lazy" alt class="logo-img-contact last"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/6a3d42840b98c9c215f2efac_download.avif" loading="lazy" alt class="logo-img-contact"></div>
          </div>
        </div>
        <div class="contact-form-block">
          <h2 class="cf-head-block"><span class="text-color-ff5570">Contact an Innovorder expert</span> to accelerate the growth of your brand.</h2>
          <div class="w-form">
            <form id="wf-form-Nous-contacter" name="wf-form-Nous-contacter" data-name="Nous contacter" redirect="/merci" data-redirect="/merci" method="get" class="form-inner" data-wf-page-id="6493777d655aea5e6643cc7e" data-wf-element-id="05eabe21-7946-b291-2acd-968dcb3fe708" data-turnstile-sitekey="0x4AAAAAAAQTptj2So4dx43e">
              <div class="contact-form-row v1"><input class="text-field-cf w-input" maxlength="256" name="Pr-nom" data-name="Prénom" placeholder="First name " type="text" id="Pr-nom" required><input class="text-field-cf w-input" maxlength="256" name="Nom" data-name="Nom" placeholder="Name" type="text" id="Nom" required></div>
              <div class="contact-form-row">
                <input class="text-field-cf w-input" maxlength="256" name="E-mail" data-name="E-mail" placeholder="E-mail" type="email" id="E-mail" required>
                <div class="text-field-wrapper">
                  <input class="text-field-cf w-input" maxlength="256" name="T-l-phone" data-name="Téléphone" placeholder="Phone" type="tel" id="phone" required>
                  <div id="phone-error" class="error-msg">Please enter a valid number</div>
                </div>
              </div>
              <input class="text-field-cf w-input" maxlength="256" name="Soci-t" data-name="Société" placeholder="Company" type="text" id="Soci-t" required>
              <select id="Activit" name="Activit" data-name="Activité" required class="text-field-cf v2 w-select">
                <option value>Activity</option>
                <option value="Fast Food">Fast food</option>
                <option value="Boulangerie, pâtisserie ou traiteur">Bakery</option>
                <option value="Food Court">Food court</option>
                <option value="Tourisme et loisirs">Tourism and Recreation</option>
                <option value="Restauration traditionnelle">Traditional catering</option>
                <option value="Société de restauration collective">Collective catering</option>
              </select>
              <select id="Nombre-de-points-de-vente" name="Nombre-de-points-de-vente" data-name="Nombre de points de vente" required class="text-field-cf v2 w-select">
                <option value>Number of sales outlets</option>
                <option value="1">1</option>
                <option value="2-3">2–3</option>
                <option value="4-10">4-10</option>
                <option value="+10">+10</option>
                <option value="En cours de création">Currently being created</option>
              </select>
              <input type="submit" data-wait="Patientez..." id="submit-btn" class="cf-submit w-button" value="Talk to an expert →">
              <div class="terms-cf">By submitting this form, you agree to be contacted by Innovorder. Your data will be processed in accordance with our <a href="/en/politique-de-confidentialite" class="link-2">privacy policy</a>.</div>
              <div class="code-embed-3 w-embed"><input type="hidden" class="utm_source" placeholder="utm_source" name="utm_source">
  <input type="hidden" class="utm_medium" placeholder="utm_medium" name="utm_medium">
  <input type="hidden" class="utm_campaign" placeholder="utm_campaign" name="utm_campaign">
  <input type="hidden" class="page_source" placeholder="page_source" name="page_source"></div>
            </form>
            <div class="success-message-3 w-form-done">
              <div>Thank you!</div>
            </div>
            <div class="w-form-fail">
              <div>Oops! Something went wrong while submitting the form.</div>
            </div>
          </div>
          <div class="code-1 w-embed">
            <style is:inline>

    .w-select.is-placeholder {
    color: rgba(38, 26, 99, 0.45);
  }

  .w-select:not(.is-placeholder) {
    color: #261A63;
  }

  body.page-no-chat #zapier-chatbot-embed {
    display: none !important;
  }

  }
  
  </style>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/css/intlTelInput.min.css">
            <style is:inline>
  .iti{
      width:100%;
  }

  .w-form,
  form,
  .text-field-wrapper{
      overflow:visible !important;
  }

  .iti input{
      width:100%;
  }

  .iti__country-list{
      max-height:250px !important;
      overflow-y:auto !important;
      -webkit-overflow-scrolling:touch;
      z-index:999999 !important;
      box-shadow:0 8px 16px rgba(0,0,0,.15);
  }
  </style>
          </div>
          <div class="code-2 w-embed w-script">
            <script is:inline>
  var Webflow = Webflow || [];
  Webflow.push(function() {
    var l = $('#flowbaseSlider .w-slider-arrow-left');
    var r = $('#flowbaseSlider .w-slider-arrow-right');
    $('#flowbaseSlider')
      .on('click', '.back-button', function() {
        l.trigger('tap');
      })
      .on('click', '.next-button', function() {
        r.trigger('tap');
      });
  });
  </script>
            <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("select").forEach(select => {
      const first = select.options[0];
      first.disabled = true;
      first.selected = true;
    });
  });
  </script>
            <script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".w-select").forEach(select => {
      const update = () => {
        select.classList.toggle("is-placeholder", select.selectedIndex === 0);
      };

      update();
      select.addEventListener("change", update);
    });
  });
  </script>
            <script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll("zapier-interfaces-chatbot-embed")
      .forEach(el => el.remove());
  });
  </script>
            <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/intlTelInput.min.js" is:inline></script>
            <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js" is:inline></script>
            <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {

      const phoneInput = document.querySelector("#phone");
      if (!phoneInput) return;

      const form = phoneInput.closest("form");
      const submitButton = form ? form.querySelector('[type="submit"]') : null;
      const errorMessage = document.querySelector("#phone-error");

      const iti = window.intlTelInput(phoneInput, {
          initialCountry: "fr",
          separateDialCode: true,
          utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js"
      });



      function isIOS() {
          return (
              /iPad|iPhone|iPod/.test(navigator.userAgent) ||
              (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)
          );
      }


      function positionDropdownIOS() {

          if (!isIOS()) return;

          const list = document.querySelector(".iti__country-list");
          if (!list) return;

          const rect = phoneInput.getBoundingClientRect();

          list.style.position = "fixed";
          list.style.left = rect.left + "px";
          list.style.top = (rect.bottom + 6) + "px";
          list.style.width = rect.width + "px";
          list.style.maxHeight = "250px";
          list.style.zIndex = "999999";
      }

      document.addEventListener("click", function(e){
          if(e.target.closest(".iti__selected-flag")){
              setTimeout(positionDropdownIOS,30);
          }
      });

      window.addEventListener("resize",positionDropdownIOS);
      window.addEventListener("scroll",positionDropdownIOS);



      function validatePhone(){

          if (!errorMessage) return true;

          if (phoneInput.value.trim() === "") {
              errorMessage.style.display = "none";
              return false;
          }

          if (iti.isValidNumber()) {
              errorMessage.style.display = "none";
              return true;
          }

          errorMessage.style.display = "flex";
          return false;
      }

      phoneInput.addEventListener("input", validatePhone);
      phoneInput.addEventListener("blur", validatePhone);



      function updateSubmitState() {

          if (!form || !submitButton) return;

          const requiredFields = form.querySelectorAll("input[required], select[required]");

          let allFilled = true;

          requiredFields.forEach((field) => {

              if (field.id === "phone") return;

              if (!field.value || !field.checkValidity()) {
                  allFilled = false;
              }

          });

          const phoneOk =
              phoneInput.value.trim() !== "" &&
              iti.isValidNumber();

          const formValid = allFilled && phoneOk;

          submitButton.disabled = !formValid;
          submitButton.style.opacity = formValid ? "1" : "0.5";
          submitButton.style.cursor = formValid ? "pointer" : "not-allowed";
      }

      form.querySelectorAll("input[required], select[required]").forEach((el) => {
          el.addEventListener("input", updateSubmitState);
          el.addEventListener("change", updateSubmitState);
      });

      phoneInput.addEventListener("input", updateSubmitState);
      phoneInput.addEventListener("countrychange", updateSubmitState);
      phoneInput.addEventListener("blur", updateSubmitState);

      updateSubmitState();



      if (form) {

          form.addEventListener("submit", function (e) {

              if (!validatePhone()) {
                  e.preventDefault();
                  return;
              }

              phoneInput.value = iti.getNumber();

          });

      }

  });
  </script>
            <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var fields = document.querySelectorAll("input.page_source");
    if (!fields.length) return;

    function fillSource() {
      fields.forEach(function (field) {
        field.value = window.location.href;
      });
    }

    fillSource();

    document.addEventListener("submit", fillSource, true);
  });
  </script>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
