      /*background: linear-gradient(90deg, #F4B573 50%, #EC6273 100%);*/
      border: 2px solid #EC6273;
      width: 15px;
      height: 15px;
      outline: none;
      font-family: Inter;
  }

  .error_mes{
      color: red;
      font-size: 12px;
      font-style: italic;
      display: none;
  }

  .calc-field-box {
      display: flex;
      width: 210px;
  }

  .calc-field-box .calc-field{
      width: 100%;
