  }

  .calc-units {
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #e5e5e5;
      padding: 2px 4px;
      border-radius: 3px 0px 0px 3px;
      color: gray;
      margin-right: -1px;
      background-color: #f3f3f3;
  }

  .calc-units-2{
      position: absolute;
      right: 12px;
      top: 12px;
