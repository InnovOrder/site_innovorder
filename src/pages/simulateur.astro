---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  "title": "Simulateur de Rentabilité Restaurant & Fast-food - Innovorder",
  "description": "Découvrez gratuitement combien vous pourriez gagner en équipant votre restaurant avec une borne de commande grâce à notre simulateur.",
  "ogImage": "/assets/cdn.prod.website-files.com/6144e950589804576d0974b3/61471053c81f4bb5160985fd_imagebck-1%20-%20copiedds.jpeg",
  "htmlAttrs": {
    "data-wf-page": "64f10bb5b90aa9dde44275e4"
  },
  "bodyClass": "body-kiosk",
  "webflowScripts": [
    {
      "src": "/assets/d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js",
      "type": "text/javascript",
      "integrity": "sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.4621b44054c4cc64.js",
      "type": "text/javascript",
      "integrity": "sha384-aghwvml5rig/T7e4zosxno6oA1Egc3cKPM6FP9ti9TCQkAoo+GH+XXh7xNn/M+6r",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.schunk.b693920686705a26.js",
      "type": "text/javascript",
      "integrity": "sha384-C/wFs2yjYA9jOcYLm4wK5l9pvcKosdzrrEqod/82XTjVD5Sa5FyXRmbPrHN7uuct",
      "crossorigin": "anonymous"
    },
    {
      "src": "/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/js/webflow.81c8caa2.7a583d2f84404f74.js",
      "type": "text/javascript",
      "integrity": "sha384-DJVlwW9hLkiHqUOtjKtqn5a4YlqRnDc0Qur0U7MOnZJttoySvb0C7QVV3p98mPpb",
      "crossorigin": "anonymous"
    }
  ],
  "alternates": {
    "fr": "https://www.innovorder.com/simulateur",
    "en": "https://www.innovorder.com/en/simulateur"
  }
};
---
<BaseLayout {...seo}>
  <Fragment slot="head">
    <style is:inline>

    	.volume-marquee__collection-wrapper {
        -webkit-animation: logoloop 90s linear infinite;
        -moz-animation: logoloop 90s linear infinite;
        -o-animation: logoloop 90s linear infinite;
    	}

    	.volume-marquee:hover .volume-marquee__collection-wrapper,
      .volume-marquee:focus-within .volume-marquee__collection-wrapper {
      	-webkit-animation-play-state: paused;
        -moz-animation-play-state: paused;
        -o-animation-play-state: paused;
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion) {
        .volume-marquee__collection-wrapper {
          -webkit-animation-play-state: paused;
          -moz-animation-play-state: paused;
          -o-animation-play-state: paused;
          animation-play-state: paused;
        }
      }

    	@-webkit-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-moz-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @-o-keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

      @keyframes logoloop {
        0% {
          transform: translateX(0%);
        }

        100% {
          transform: translateX(-100%);
        }
      }

    </style>
  </Fragment>
  <div class="overflow-hidden">
    <div class="gtm-embed w-embed"></div>
    <div class="section-hero-n simulator">
      <div class="container-1280">
        <a href="/" class="link-logo-simulator w-inline-block"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/63f501f2fcfc5931ce19fd4b_Logo%20Innovorder.svg" loading="lazy" width="193" alt class="logo-simulator"></a>
        <div class="simulateur-wrap-hero">
          <div id="w-node-_385c522c-6a18-b2e9-026d-ec58d289342e-e44275e4" class="text-expertise-block-hero simulator">
            <h1 data-w-id="385c522c-6a18-b2e9-026d-ec58d289342f" style="opacity:0" class="title-00 kiosk"><span class="gradient-text">Simulateur de rentabilité</span> pour votre restaurant, fast-food ou franchise</h1>
            <div data-w-id="bab8965b-fa67-b2f0-8532-b37fec4fb17e" style="opacity:0" class="sub-txt-simulateur">Calculez la rentabilité de votre établissement de restauration rapide !</div>
            <p class="text-17px expertise left-algn-mob">Découvrez gratuitement combien vous pourriez gagner de revenus supplémentaires en équipant votre restaurant avec les solutions digitales Innovorder :</p>
            <ul data-w-id="f2a72037-9449-fe88-28dd-1a8f5f0abbb8" style="opacity:0" role="list">
              <li class="list-item"><strong>borne de commande</strong></li>
              <li class="list-item"><strong>écran de production</strong> (KDS)</li>
              <li class="list-item"><strong>commande en ligne</strong> (livraison et click &amp; collect)</li>
            </ul>
          </div>
          <div id="w-node-_385c522c-6a18-b2e9-026d-ec58d2893439-e44275e4" class="image-block-hero-expertise hide-mob"><img src="/assets/cdn.prod.website-files.com/63f501f2fcfc59779719f99c/64f10e369eebe24d71dc9757_simulateur-hero.webp" loading="lazy" alt="La meilleure borne de commande pour les restaurants et fast-foods" class="image-hero-expertise simulator"></div>
        </div>
      </div>
    </div>
    <div class="section-20 simulator">
      <div class="container-1280">
        <div data-w-id="8127563a-09bc-a254-f0d2-f9a02ba48f9b" style="opacity:0" class="sub-txt-simulateur space"><strong>👇 Découvrez votre résultat en quelques secondes !</strong></div>
        <div data-w-id="84213bcb-f386-7ec9-98c9-5a631f4fc35e" style="opacity:0" class="embed-calculator w-embed w-script">
          <div class="calc-body">
            <div class="calc">
              <div class="calc-field-group">
                <label>Combien de restaurants gérez-vous ?</label>
                <input type="text" id="q2" class="calc-field">
                <div class="error_mes q2-error">Valeur manquante</div>
              </div>
              <div class="calc-field-group">
                <label>Combien de tickets réalisez-vous en moyenne par jour (par point de vente) ?</label>
                <input type="text" id="q3" class="calc-field">
                <div class="error_mes q3-error">Valeur manquante</div>
              </div>
              <div class="calc-field-group">
                <label>Quel est montant du panier moyen dans votre établissement ?</label>
                <div style="position: relative; width: fit-content;">
                  <input type="text" id="q4" class="calc-field">
                  <span class="calc-units-2">€ </span>
              </div>
                <div class="error_mes q4-error">Valeur manquante</div>
              </div>
              <div class="calc-field-group">
                <label>Combien de jours par semaine votre établissement est-il ouvert ?</label>
                <div class="calc-scale">
                  <div class="calc-scale-step calc-scale-step-active">1</div>
                  <div class="calc-scale-step">2</div>
                  <div class="calc-scale-step">3</div>
                  <div class="calc-scale-step">4</div>
                  <div class="calc-scale-step">5</div>
                  <div class="calc-scale-step">6</div>
                  <div class="calc-scale-step">7</div>
                </div>
                <input type="text" id="q5" class="calc-field" value="1" style="display: none">
                <div id="q5-slider" class="slider">

              </div>
              </div>
            </div>
            <div class="calc-result">
              <div class="calc-h3">Résultats pour <span class="calc-h3-orange">votre restaurant.</span></div>
              <div id="ordering-kiosk-results" class="calc-result-part">
              <span id="kiosk-1" class="calc-result-value">+0,00€</span> de revenus mensuels supplémentaires en installant <b><span id="kiosk-2">X</span> borne<span class="calc-kiosk-s"></span> de commande</b> par point de vente<span class="calc-restaurant-s"></span>
          </div>
              <div id="online-ordering-results" class="calc-result-part">
              <span id="online-1" class="calc-result-value">+0,00€</span> de revenus mensuels supplémentaires en servant <b><span id="online-2">X</span> nouveaux clients</b> grâce à la commande en ligne
          </div>
              <div id="kds-results" class="calc-result-part">
              <span class="calc-result-value">+37%</span> de productivité gagnée en cuisine en installant <b><span id="kds-2">X</span> écran<span class="calc-kds-s"></span> de production (KDS)</b>
          </div>
              <input type="button" value="Être recontacté" onclick="location.href='#form';" class="calc-button">
            </div>
          </div>
          <script src="https://code.jquery.com/jquery-3.5.1.js" integrity="sha256-QWo7LDvxbWT2tbbQ97B53yJnYU3WhH/C8ycbRAkjPDc=" crossorigin="anonymous" is:inline></script>
          <script src="https://code.jquery.com/ui/1.12.0/jquery-ui.js" integrity="sha256-0YPKAwZP7Mp3ALMRVB2i8GXeEndvCq3eSl/WsAl1Ryk=" crossorigin="anonymous" is:inline></script>
          <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js" is:inline></script>
          <script is:inline>
  $("#q5-slider").slider({
      animate: "slow",
      range: "min",
      value: 1,
      max: 7,
      min: 1,
      slide: function (event, ui) {
          $("#q5").val(ui.value);
          $(".calc-scale-step").removeClass("calc-scale-step-active");
          $(".calc-scale-step").eq(ui.value-1).addClass("calc-scale-step-active");
          Calc();
      }
  });

  $(document).ready(function (){
      $("#ordering-kiosk-results").css("opacity", "0.2");
      $("#online-ordering-results").css("opacity", "0.2");
      $("#kds-results").css("opacity", "0.2");
  })

  $("#calc-button").on("click",  function (){
      Calc();
  });

  function Calc(){
      $(".error_mes").hide();
      var error = 0;

      $("#ordering-kiosk-results").css("opacity", "0.2");
      $("#online-ordering-results").css("opacity", "0.2");
      $("#kds-results").css("opacity", "0.2");

      var Q2 = Convers($("#q2").val());
      var Q3 = Convers($("#q3").val());
      var Q4 = Convers($("#q4").val());
      var Q5 = Convers($("#q5").val());

      if(Q2=="" || Q2==0){
          $(".q2-error").show();
          error=1;
      }
      if(Q3=="" || Q3==0){
          $(".q3-error").show();
          error=1;
      }
      if(Q4=="" || Q4==0){
          $(".q4-error").show();
          error=1;
      }

      var kiosk = [];
      var online = [];
      var kds = [];

      kiosk[0] = Q2 * Q3 * 1.05 * ((Q4*1.28) - Q4) * Q5 * 52/12;
      kiosk[1] = Math.floor((Q3-70) / 80)+1;

      online[0] = Q2 * (Q3 * 1.13 - Q3) * (Q4*1.43) * Q5 * 52/12;
      online[1] = Math.ceil(Q2 * (Q3 * 1.13 - Q3));

      kds[0] = 37;
      kds[1] = Math.floor((Q3-70) / 80)+1;

      if (kds[1]==0){kds[1]=1;}
      if (kiosk[1]==0){kiosk[1]=1;}

      if(error==0){
          if(Q2>1){
              $(".calc-restaurant-s").text("s");
          }else{
              $(".calc-restaurant-s").text("");
          }

          if(kiosk[1]>1){
              $(".calc-kiosk-s").text("s");
          }else {
              $(".calc-kiosk-s").text("");
          }

          if(kds[1]>1){
              $(".calc-kds-s").text("s");
          }else {
              $(".calc-kds-s").text("");
          }
          $("#kiosk-1").text("+"+kiosk[0].toFixed(2)+"€");
          $("#kiosk-2").text(kiosk[1].toFixed(0));
          $("#online-1").text("+"+online[0].toFixed(2)+"€");
          $("#online-2").text(online[1].toFixed(0));
          $("#kds-2").text(kds[1].toFixed(0));

          if(Q3>70){
              $("#kds-results").css("opacity", "1");
              $("#ordering-kiosk-results").css("opacity", "1");
          }else{
              $("#kds-results").css("opacity", "0.2");
              $("#ordering-kiosk-results").css("opacity", "0.2");

              $("#kiosk-1").text("+0,00€");
              $("#kiosk-2").text("0");
              $("#kds-2").text("0");
          }
          $("#online-ordering-results").css("opacity", "1");
      }else{
          $("#online-ordering-results").css("opacity", "0.2");
          $("#kds-results").css("opacity", "0.2");
          $("#ordering-kiosk-results").css("opacity", "0.2");


          $("#kiosk-1").text("+0,00€");
          $("#kiosk-2").text("0");
          $("#online-1").text("+0,00€");
          $("#online-2").text("00");
          $("#kds-2").text("0");
      }
  }



  $(document).on("keyup", ".calc-field", function (){
      var numcheck = $(this).val();
      numcheck = numcheck.replace(/[^0-9\.]/g, '');
      //numcheck = addCommas(numcheck);
      $(this).val(numcheck);
      Calc();
  });

  // add commas to amount
  function addCommas(nStr) {
      nStr += '';
      var x = nStr.split('.');
      var x1 = x[0];
      var x2 = x.length > 1 ? '.' + x[1] : '';
      var rgx = /(\d+)(\d{3})/;
      while (rgx.test(x1)) {
          x1 = x1.replace(rgx, '$1' + ',' + '$2');
      }
      formattedamount = x1 + x2
      return formattedamount;
  }

  function Convers(e){
      e = e.replace(/[^0-9\.]/g, '')*1;
      return e;
  }
  </script>
        </div>
        <div class="stylesheet-calculator w-embed">
          <link href="https://code.jquery.com/ui/1.13.1/themes/smoothness/jquery-ui.css" rel="stylesheet" type="text/css">
