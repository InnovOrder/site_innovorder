        {
          "@type": "FAQPage",
          "@id": "https://www.innovorder.com/ecran-cuisine-production#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Quelle est la différence entre un écran de cuisine, un écran de production, un KDS et un écran d’affichage ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Il n’y en a aucune ! Écran de cuisine, écran de production, KDS (Kitchen Display System) et écran d’affichage servent le même objectif : faciliter la vie en cuisine et l'organisation des préparateurs."
              }
            },
            {
              "@type": "Question",
              "name": "Quel est le prix d’un écran de cuisine ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Innovorder propose un abonnement à ses solutions. Pour connaître le prix d’un écran de production, contactez un conseiller Innovorder pour recevoir un devis sur-mesure adapté à votre restaurant."
              }
            },
            {
              "@type": "Question",
              "name": "Comment installer un écran de production dans la cuisine de son restaurant ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nos experts s’occupent de tout ! Notre équipe se déplace dans votre restaurant pour installer, paramétrer et former vos préparateurs à l’utilisation des écrans de production."
              }
            },
            {
              "@type": "Question",
              "name": "Pourquoi équiper son restaurant avec un écran de cuisine ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un écran de cuisine permet d’augmenter la productivité des équipes, de fluidifier l’organisation du restaurant et de simplifier le quotidien des préparateurs pour un gain d’efficacité considérable."
              }
            },
            {
              "@type": "Question",
              "name": "Comment bien choisir son écran de cuisine ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Il faut vérifier plusieurs critères : taille de la cuisine, nombre de postes à équiper, volume de vente, budget, fonctionnalités et facilité de prise en mains. Contactez-nous pour l'avis d'un expert !"
              }
            },
            {
              "@type": "Question",
              "name": "A partir de combien de tickets un écran de cuisine est-il utile ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un écran de cuisine est recommandé dès 70/80 tickets par jour. Nous conseillons ensuite 1 écran supplémentaire par tranche de 80 tickets pour garantir une fluidité totale."
              }
            },
            {
              "@type": "Question",
              "name": "Que se passe-t-il en cas d’erreur de clic ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Notre système inclut un historique des commandes permettant de remettre en cours une commande validée par erreur en un seul clic."
              }
            },
            {
              "@type": "Question",
              "name": "Peut-on utiliser plusieurs écrans de production pour répartir les commandes ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Oui, il est possible de dispatcher les commandes entre plusieurs écrans selon les postes de production (grill, frites, pizza, etc.) pour une organisation optimale des tâches."
              }
            }
          ]
        }
