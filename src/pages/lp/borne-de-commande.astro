    <div id="paiement" class="section container">
      <div class="page-padding">
        <div class="container-large">
          <div class="w-layout-grid feature-2-column">
            <div id="w-node-e9c1509b-6213-7e17-5d86-40d8bd0a1273-6643cbb0" class="card-1-large bg-gray-6 fade-in-1st">
