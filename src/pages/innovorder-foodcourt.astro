    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://www.innovorder.com/foodcourt#webpage",
          "url": "https://www.innovorder.com/foodcourt",
          "name": "Solution digitale pour Foodcourt : Commande & Paiement unique | Innovorder",
          "description": "Optimisez la gestion de votre foodcourt avec Innovorder. Une interface unique pour tous vos restaurants, commande par QR Code et paiement centralisé.",
