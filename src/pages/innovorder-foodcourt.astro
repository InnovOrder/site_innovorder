            "@id": "https://www.innovorder.com/foodcourt#breadcrumb"
          },
          "mainEntity": {
            "@id": "https://www.innovorder.com/foodcourt#product"
          }
        },
        {
          "@type": "BreadcrumbList",
          "@id": "https://www.innovorder.com/foodcourt#breadcrumb",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Accueil",
              "item": "https://www.innovorder.com"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Foodcourt",
              "item": "https://www.innovorder.com/foodcourt"
            }
          ]
        },
        {
          "@type": "Product",
          "@id": "https://www.innovorder.com/foodcourt#product",
          "name": "Innovorder Foodcourt",
          "description": "Solution logicielle complète pour foodcourts : commande multi-enseignes, paiement unifié et gestion centralisée des flux.",
          "brand": {
            "@type": "Brand",
            "name": "Innovorder"
          },
          "manufacturer": {
            "@type": "Organization",
            "@id": "https://www.innovorder.com/#organization",
            "name": "Innovorder",
            "url": "https://www.innovorder.com"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "442"
          }
        },
        {
          "@type": "VideoObject",
          "name": "Gestion digitale d'un Foodcourt avec Innovorder",
          "description": "Découvrez comment centraliser les commandes et les paiements de plusieurs restaurants sur une seule et même interface QR Code.",
          "thumbnailUrl": "https://img.youtube.com/vi/E0Wglp92h7o/maxresdefault.jpg",
          "uploadDate": "2024-03-21T09:00:00+01:00",
          "embedUrl": "https://www.youtube.com/embed/E0Wglp92h7o",
          "contentUrl": "https://www.innovorder.com/foodcourt"
        },
        {
          "@type": "FAQPage",
          "@id": "https://www.innovorder.com/foodcourt#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Pourquoi équiper son foodcourt avec des QR codes ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un QR code dédié permet de fluidifier le service et d’augmenter le panier moyen. Il offre une expérience unique en rassemblant tous les produits des différents restaurants sur une même interface."
              }
            },
            {
              "@type": "Question",
              "name": "Les clients doivent-ils télécharger une app pour commander à table avec Innovorder ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Aucune application n'est requise. Un smartphone et une connexion Internet suffisent pour scanner le QR code et accéder à l'interface de commande."
              }
            },
            {
              "@type": "Question",
              "name": "Les clients peuvent-ils payer en espèces ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Innovorder Foodcourt ne propose pas cette option. Les clients règlent leur commande directement via l’interface de paiement numérique pour plus de rapidité."
              }
            }
          ]
        }
      ]
    }
    </script>
