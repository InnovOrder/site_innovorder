          "@id": "https://www.innovorder.com/monnayeur-automatique#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Qu’est-ce qu’un monnayeur automatique ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un monnayeur automatique est un boîtier sécurisé et autonome qui permet de récolter et distribuer la monnaie sur un point de vente. Le client dépose ses pièces et billets, et le monnayeur rend le montant exact automatiquement."
              }
            },
            {
              "@type": "Question",
              "name": "Est-il possible de synchroniser un monnayeur à la caisse enregistreuse Innovorder ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "En vous équipant avec Innovorder, vous avez l’assurance que votre monnayeur et votre caisse enregistreuse sont parfaitement synchronisés pour une gestion fluide des transactions."
              }
            },
            {
              "@type": "Question",
              "name": "Quels domaines d’activités peuvent avoir recours au monnayeur ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Le monnayeur automatique est recommandé pour les points de vente avec un fort volume d'espèces : boulangeries, fast-foods, snacking et enseignes en réseau où la rapidité et la sécurité sont essentielles."
              }
            }
          ]
        }
