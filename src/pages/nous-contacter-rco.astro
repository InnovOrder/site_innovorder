    <script is:inline>
    var Webflow = Webflow || [];
    Webflow.push(function() {
      var l = $('#flowbaseSlider .w-slider-arrow-left');
      var r = $('#flowbaseSlider .w-slider-arrow-right');
      $('#flowbaseSlider')
        .on('click', '.back-button', function() {
          l.trigger('tap');
        })
        .on('click', '.next-button', function() {
          r.trigger('tap');
        });
    });
    </script>
    <script src="https://cdn.jsdelivr.net/gh/videsigns/webflow-tools@latest/multi-step.js" is:inline></script>
    <script is:inline>

    // Function to extract URL parameters
    function getUrlParameter(name) {
        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
        const regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
        const results = regex.exec(window.location.href);
        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    }

    // Populate hidden fields with UTM parameters
    document.addEventListener('DOMContentLoaded', () => {
        const utmSource = getUrlParameter('utm_source');
        const utmMedium = getUrlParameter('utm_medium');
        const utmCampaign = getUrlParameter('utm_campaign');

        if (utmSource) {
            document.querySelector('.utm_source').value = utmSource;
        }
        if (utmMedium) {
            document.querySelector('.utm_medium').value = utmMedium;
        }
        if (utmCampaign) {
            document.querySelector('.utm_campaign').value = utmCampaign;
        }
    });


    </script>
  </Fragment>
