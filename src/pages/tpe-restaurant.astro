  		const tabPanes = document.querySelectorAll(".w-tab-pane");

  		tabLinks.forEach((tabLink, index) => {
  			const pane = tabPanes[index];
  			const imgWrapper = pane.querySelector(".tab-faq-img-wrapper");

  			if (imgWrapper) {
  				const mobileImgClone = imgWrapper.cloneNode(true);
  				mobileImgClone.classList.add("mobile-only-image");

  				const textElement = tabLink.querySelector(".tab_faq-text");
  				textElement.insertBefore(mobileImgClone, textElement.firstChild);
  			}
  		});
  	});
  </script>
