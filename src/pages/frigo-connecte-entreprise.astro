          "@type": "FAQPage",
          "@id": "https://www.innovorder.com/frigo-connecte-entreprise#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Qu’est-ce qu’un frigo connecté d’entreprise ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un frigo connecté d’entreprise est spécialement conçu pour la restauration collective. Installé en cafétéria ou espace de coworking, il propose aux salariés des repas sains préparés quotidiennement en libre-service."
              }
            },
            {
              "@type": "Question",
              "name": "Comment fonctionne un frigo connecté d’entreprise ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Le convive scanne son badge, sa carte bancaire ou son ticket restaurant dématérialisé pour ouvrir le frigo. Il sélectionne ses produits et referme la porte, ce qui finalise l’achat automatiquement."
              }
            },
            {
              "@type": "Question",
              "name": "Comment installer un frigo connecté dans son entreprise ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Une simple prise de courant et une connexion Internet suffisent, sans travaux. Innovorder prend en charge l’installation et le paramétrage complet."
              }
            },
            {
              "@type": "Question",
              "name": "Quelle est la surface nécessaire pour installer un frigo connecté ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un frigo connecté occupe à peine plus de place qu’un frigo classique. Contactez un conseiller Innovorder pour obtenir les dimensions exactes selon les modèles."
              }
            },
            {
              "@type": "Question",
              "name": "Quelle est la capacité d’un frigo connecté d’entreprise ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La capacité moyenne est de 50 couverts, variant selon le type de contenants et le modèle de frigo choisi."
              }
            },
            {
              "@type": "Question",
              "name": "Quels sont les avantages d’un frigo connecté pour une entreprise ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Il permet de diversifier l’offre de restauration 24h/24, d’optimiser la gestion des stocks en temps réel et de réduire les besoins en personnel de service."
              }
            },
            {
              "@type": "Question",
              "name": "Quels types de produits puis-je proposer dans un frigo connecté ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vous pouvez proposer une large gamme : plats préparés, snacks, boissons, desserts, salades et sandwiches."
              }
            },
            {
              "@type": "Question",
              "name": "Comment s’effectue le paiement sur le frigo connecté ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Le paiement est 100 % sécurisé et sans contact via carte bancaire, mobile (Apple Pay, Google Pay) ou badge entreprise."
              }
            }
          ]
        }
